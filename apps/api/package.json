{
  "name": "@praxis/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "openapi": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "5.2.6",
    "@node-rs/argon2": "2.2.1",
    "@praxis/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "fastify": "5.12.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "4.0.2",
    "ioredis": "5.11.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
