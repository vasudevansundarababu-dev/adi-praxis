{
  "$defs": {
    "ActionV2": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "const": "submit_json",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "kind"
      ],
      "title": "ActionV2",
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "json_equals",
            "json_number_min",
            "json_number_max"
          ],
          "title": "Kind",
          "type": "string"
        },
        "field": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Field",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "field",
        "value"
      ],
      "title": "Binding",
      "type": "object"
    },
    "Constraint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "hard_failure": {
          "title": "Hard Failure",
          "type": "boolean"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        }
      },
      "required": [
        "id",
        "description",
        "hard_failure",
        "binding"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "weight_bps": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Weight Bps",
          "type": "integer"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        }
      },
      "required": [
        "id",
        "description",
        "weight_bps",
        "binding"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "Deliverable": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "const": "output.json",
          "title": "Path",
          "type": "string"
        },
        "description": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "description"
      ],
      "title": "Deliverable",
      "type": "object"
    },
    "EnvironmentV2": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "const": "staged-decision-v1",
          "title": "Binding",
          "type": "string"
        },
        "initial_state": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "title": "Initial State",
          "type": "object"
        }
      },
      "required": [
        "binding",
        "initial_state"
      ],
      "title": "EnvironmentV2",
      "type": "object"
    },
    "EvidenceV2": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "actor",
            "private",
            "future"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "content": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "reveal_stage_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reveal Stage Id"
        }
      },
      "required": [
        "id",
        "visibility",
        "content"
      ],
      "title": "EvidenceV2",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "synthetic",
          "title": "Classification",
          "type": "string"
        },
        "source": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "rights": {
          "$ref": "#/$defs/Rights"
        },
        "review": {
          "$ref": "#/$defs/Review"
        }
      },
      "required": [
        "classification",
        "source",
        "rights",
        "review"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "draft",
            "approved"
          ],
          "title": "Status",
          "type": "string"
        },
        "reviewer_ref": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Reviewer Ref",
          "type": "string"
        },
        "reviewed_revision_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Reviewed Revision Id",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reviewer_ref",
        "reviewed_revision_id"
      ],
      "title": "Review",
      "type": "object"
    },
    "Rights": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "declared",
          "title": "Status",
          "type": "string"
        },
        "basis": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "status",
        "basis"
      ],
      "title": "Rights",
      "type": "object"
    },
    "Rubric": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "reference_output": {
          "additionalProperties": true,
          "title": "Reference Output",
          "type": "object"
        }
      },
      "required": [
        "criteria",
        "reference_output"
      ],
      "title": "Rubric",
      "type": "object"
    },
    "StageV2": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "instruction": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Ids",
          "type": "array"
        },
        "completion": {
          "const": "submit_output_json",
          "title": "Completion",
          "type": "string"
        },
        "action_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Action Id",
          "type": "string"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/Constraint"
          },
          "maxItems": 50,
          "title": "Constraints",
          "type": "array"
        },
        "rubric": {
          "$ref": "#/$defs/Rubric"
        },
        "state_updates": {
          "items": {
            "$ref": "#/$defs/StateUpdate"
          },
          "maxItems": 50,
          "title": "State Updates",
          "type": "array"
        }
      },
      "required": [
        "id",
        "instruction",
        "evidence_ids",
        "completion",
        "action_id",
        "constraints",
        "rubric",
        "state_updates"
      ],
      "title": "StageV2",
      "type": "object"
    },
    "StateUpdate": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Key",
          "type": "string"
        },
        "from_field": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "From Field",
          "type": "string"
        }
      },
      "required": [
        "id",
        "key",
        "from_field"
      ],
      "title": "StateUpdate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "praxis.anvil.task.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
      "title": "Task Id",
      "type": "string"
    },
    "task_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
      "title": "Task Version",
      "type": "string"
    },
    "revision_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
      "title": "Revision Id",
      "type": "string"
    },
    "title": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "objective": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceV2"
      },
      "maxItems": 100,
      "title": "Evidence",
      "type": "array"
    },
    "constraints": {
      "items": {
        "$ref": "#/$defs/Constraint"
      },
      "maxItems": 50,
      "title": "Constraints",
      "type": "array"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentV2"
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/ActionV2"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Actions",
      "type": "array"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageV2"
      },
      "maxItems": 12,
      "minItems": 2,
      "title": "Stages",
      "type": "array"
    },
    "deliverables": {
      "items": {
        "$ref": "#/$defs/Deliverable"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Deliverables",
      "type": "array"
    },
    "rubric": {
      "$ref": "#/$defs/Rubric"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "task_version",
    "revision_id",
    "title",
    "objective",
    "evidence",
    "constraints",
    "environment",
    "actions",
    "stages",
    "deliverables",
    "rubric",
    "provenance"
  ],
  "title": "PraxisTaskV2",
  "type": "object"
}
