          "version": 1,
          "text": "[Fixture wording for contract tests, not an approved rule] Rate high when any high-weight factor is present (among them, joint holders with no documented family relationship) or three or more factors are; medium for one or two other factors; low for none. Low: no effect. Medium: the account may be recommended for approval, with officer verification required. High: no approval; refer the customer for enhanced due diligence.",
          "text_sha256": "0979e2bbe9d7a75c2a9ef0f596bdcbe2d8f53a4c6e87fb58ec0fc815108b53a2",
          "effect": "obligation",
          "condition": {
            "all": [
              {
                "fact": "process",
                "op": "eq",
                "value": "account_opening"
              },
              {
                "fact": "product_line",
                "op": "eq",
                "value": "deposit"
              },
              {
                "fact": "product",
                "op": "in",
                "value": [
                  "adult_joint",
                  "custodial",
                  "teen_joint"
                ]
              }
            ]
          },
          "effective": {
            "mode": "from_date",
            "from": "2026-01-01"
          },
          "source": {
            "document_id": "doc-bank-sop-addendum",
            "document_version": 1,
            "quote": "[Fixture wording for contract tests, not an approved rule] Medium: approval with officer verification. High: enhanced due diligence, no approval."
          },
          "approval": {
            "state": "approved",
            "approved_by": "pm-fixture",
            "approved_at": "2026-11-25T12:00:00Z",
            "approval_id": "appr-doc-bank-sop-addendum-1-3d1a0110"
          }
        }
      ]
    },
