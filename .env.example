# Copy to .env for local dev. Never commit real secrets.
# local | staging | production (staging accepts Stripe test-mode identity; production requires live)
APP_ENV=local

# --- Database (docker-compose defaults) ---
DATABASE_URL=postgresql://praxis:praxis@localhost:5442/praxis
TEST_DATABASE_URL=postgresql://praxis:praxis@localhost:5442/praxis_test

# --- Redis ---
REDIS_URL=redis://localhost:6389

# --- API ---
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Allowed browser origins for the console and candidate apps (comma separated)
CORS_ORIGINS=http://localhost:3100,http://localhost:3101
# Internal-user session lifetime in hours
SESSION_TTL_HOURS=12
# Set to true behind HTTPS so session cookies are Secure
COOKIE_SECURE=false

# --- Seed: first Admin account (local dev only) ---
SEED_ADMIN_EMAIL=admin@praxis.local
SEED_ADMIN_PASSWORD=change-me-locally-please
SEED_CLIENT_NAME=ADI-Labs
# Template catalog source (defaults to docs/Taskflow.xlsx)
TASKFLOW_PATH=

# --- Email (Mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1035
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="ADI Praxis <no-reply@praxis.local>"

# --- Storage (fake-gcs-server locally) ---
GCS_EMULATOR_HOST=http://localhost:4443
GCS_PROJECT_ID=praxis-local

# --- Candidate app ---
CANDIDATE_APP_URL=http://localhost:3101
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- External services (mocked in local dev and tests when blank; production requires them) ---
# Candidate Google sign-in: blank = local "Dev sign-in (mock Google)" screen
GOOGLE_OAUTH_CLIENT_ID=
# Stripe Identity: blank = local mock with a dev simulation panel
STRIPE_SECRET_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=
# Signs local-dev mock credentials and webhooks; never used in production
MOCK_SECRET=local-dev-mock-secret-not-for-production
# SME profile assistant (Claude via Vertex AI). Blank = local heuristic mock; production requires it.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
# Near-duplicate detection embeddings (Vertex AI text embeddings; same project). Blank project = local hashing mock.
EMBEDDING_LOCATION=us-central1
EMBEDDING_MODEL=text-embedding-005
# Nightly hash-chain verification of the append-only dataset (UTC cron)
DATASET_VERIFY_CRON=0 3 * * *
# FLOW 4: results to RL Gym by signed webhook (blank URL = RL Gym pulls results with its API key)
RL_GYM_WEBHOOK_URL=
RL_GYM_WEBHOOK_SECRET=
EVIDENCE_BUCKET=praxis-evidence

# M10 SME supply (docs/SME-SUPPLY.md). Off by default.
SME_SUPPLY_ENABLED=false
# 32 random bytes, base64 (openssl rand -base64 32). Required in production when M10 is on.
M10_ENCRYPTION_KEY=
PARTNER_API_TOKEN_TTL_SECONDS=3600
# M10b certification models on Vertex (bulk: per-candidate questions and the solver check; blank = CERT_MODEL).
CERT_MODEL=claude-opus-5
CERT_BULK_MODEL=

# M10c payouts (Trolley). Blank = local payout mock (refused in production when SME_SUPPLY_ENABLED is on).
TROLLEY_ACCESS_KEY=
TROLLEY_SECRET_KEY=
TROLLEY_WEBHOOK_SECRET=
TROLLEY_API_URL=https://api.trolley.com
TROLLEY_WIDGET_URL=https://widget.trolley.com
# Pay-run total above which a second Finance approver is required. Blank = single approver (flagged in the audit log).
PAYRUN_SECOND_APPROVAL_ABOVE=

# Support Bot model on Vertex (docs/SUPPORT-BOT.md). Used only when VERTEX_PROJECT_ID is set; otherwise a local mock.
# Support Bot model: same forms as AUTHORING_MODEL (gemini:<model> or a Claude id). Empty = follow a Gemini
# AUTHORING_MODEL (QA), otherwise claude-sonnet-5.
SUPPORT_MODEL=
# Authoring v2.1 chatbot facilitator on Vertex (owner: Sonnet 5.5 for cost; claude-haiku-5-5 is the cheap backup;
# gemini:<model> selects Gemini on Vertex, e.g. gemini:gemini-3.8-flash (QA, while Claude quota is unavailable);
# live in QA; mock when VERTEX_PROJECT_ID is blank) and its per-client
# daily call cap. Smoke check in QA: pnpm --filter @praxis/api exec tsx scripts/vertex-smoke.ts
# Wave 3: maas:<publisher>/<model> selects a Vertex MaaS open model through Vertex's OpenAI-compatible endpoint,
# using the exact id from the Model Garden card, e.g. maas:openai/gpt-oss-120b-maas (enable it in Model Garden first;
# docs/authoring/WAVE-3-TEST-NOTES.md). Same cap, logging and validators as the Claude/Gemini paths.
AUTHORING_MODEL=claude-sonnet-5-5
AUTHORING_DAILY_CALL_CAP=300
# Vertex location for a maas: model (the region on its model card, or global). Blank = VERTEX_LOCATION.
AUTHORING_MAAS_LOCATION=

# --- Templates Meta-Compiler (docs/architecture/ARCH-TEMPLATES-META-COMPILER.md section 10) ---
# provider:model pairs offered on Screen 3 (Claude and Gemini on Vertex)
META_COMPILER_MODELS=claude:claude-sonnet-5,gemini:gemini-3-pro
# Live paid generation: staging/production only, needs VERTEX_PROJECT_ID and both caps (USD). Never on locally.
META_COMPILER_LIVE_AI=false
GENERATION_COST_CAP_USD=
GENERATION_DAILY_BUDGET_USD=
# Phase C full-code generation and the real-public-data switch (both off by default)
META_COMPILER_CODEGEN_ENABLED=false
REAL_DATA_ENABLED=false
# Harbor verification runner: mock | docker (local only) | job (Cloud Run sandbox job named below)
HARBOR_RUNNER=mock
HARBOR_VERIFY_JOB=
