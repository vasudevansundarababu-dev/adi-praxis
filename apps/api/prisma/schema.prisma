// Templates Meta-Compiler (docs/architecture/ARCH-TEMPLATES-META-COMPILER.md section 3.2)

/// Per-domain, Admin-editable custom-field presets for the Guided Elicitation Assistant (D7).
model ElicitationPreset {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  domainId  String   @map("domain_id") @db.Uuid
  label     String
  /// A CustomField from the shared blueprint schema.
  field     Json
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  domain Domain @relation(fields: [domainId], references: [id])

  @@unique([domainId, label])
  @@index([clientId, domainId])
}

/// Screen 3 Step 1. Idempotent on (template, prompt hash, mode, model) (S3-03).
model CompilerGenerationRun {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String                @map("client_id") @db.Uuid
  templateId       String                @map("template_id") @db.Uuid
  templateVersion  Int                   @map("template_version")
  mode             GenerationMode        @default(BLUEPRINT)
  provider         DrafterProvider
  model            String
  promptHash       String                @map("prompt_hash")
  status           MetaCompilerRunStatus @default(QUEUED)
  /// { ui, backend, message }
  progress         Json                  @default("{\"ui\":0,\"backend\":0,\"message\":\"Queued\"}")
  estimatedCostUsd Decimal?              @map("estimated_cost_usd") @db.Decimal(10, 4)
  actualCostUsd    Decimal?              @map("actual_cost_usd") @db.Decimal(10, 4)
  inputTokens      Int?                  @map("input_tokens")
  outputTokens     Int?                  @map("output_tokens")
  outputRef        String?               @map("output_ref")
  outputSha256     String?               @map("output_sha256")
  logRef           String?               @map("log_ref")
  error            String?
  requestedById    String                @map("requested_by_id") @db.Uuid
  startedAt        DateTime?             @map("started_at")
  finishedAt       DateTime?             @map("finished_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  template      Template                  @relation(fields: [templateId], references: [id])
  verifications CompilerVerificationRun[]

  @@unique([templateId, promptHash, mode, model])
  @@index([clientId, createdAt])
}

/// Screen 3 Step 2. Scores are measured by the sandbox runner and stored with evidence (D-12).
model CompilerVerificationRun {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String                @map("client_id") @db.Uuid
  generationRunId   String                @map("generation_run_id") @db.Uuid
  status            MetaCompilerRunStatus @default(QUEUED)
  /// [{ id, passed, value, evidence }] for checks 01-05.
  checks            Json                  @default("[]")
  zeroBaselineScore Decimal?              @map("zero_baseline_score") @db.Decimal(4, 2)
  oracleScore       Decimal?              @map("oracle_score") @db.Decimal(4, 2)
  bundleRef         String?               @map("bundle_ref")
  bundleSha256      String?               @map("bundle_sha256")
  runnerRef         String?               @map("runner_ref")
  logRef            String?               @map("log_ref")
  error             String?
  requestedById     String                @map("requested_by_id") @db.Uuid
  startedAt         DateTime?             @map("started_at")
  finishedAt        DateTime?             @map("finished_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  generationRun CompilerGenerationRun @relation(fields: [generationRunId], references: [id])
  deployments   StudioDeployment[]

  @@index([clientId, generationRunId])
}

/// One studio per (template lineage, project, SME); studioKey survives redeploys (D14, S3-09).
model StudioDeployment {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String                 @map("client_id") @db.Uuid
  templateId        String                 @map("template_id") @db.Uuid
  templateLineageId String                 @map("template_lineage_id") @db.Uuid
  templateVersion   Int                    @map("template_version")
  projectId         String                 @map("project_id") @db.Uuid
  candidateId       String                 @map("candidate_id") @db.Uuid
  verificationRunId String                 @map("verification_run_id") @db.Uuid
  studioKey         String                 @unique @map("studio_key")
  status            StudioDeploymentStatus @default(ACTIVE)
  runtime           StudioRuntime          @default(SHARED)
  deployedById      String                 @map("deployed_by_id") @db.Uuid
  stoppedAt         DateTime?              @map("stopped_at")
  stoppedById       String?                @map("stopped_by_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  template         Template                @relation(fields: [templateId], references: [id])
  project          Project                 @relation(fields: [projectId], references: [id])
  candidate        Candidate               @relation(fields: [candidateId], references: [id])
  verificationRun  CompilerVerificationRun @relation(fields: [verificationRunId], references: [id])
  smeAuthoredTasks SmeAuthoredTask[]

  @@unique([templateLineageId, projectId, candidateId])
  @@index([clientId, status])
}

/// PDF §7.1 sme_authored_tasks, linked to the existing task chain (D8 = A, D-11, D-13). taskJson, bundleSha256 and
/// dataClassification are immutable after insert (database trigger).
model SmeAuthoredTask {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId             String             @map("client_id") @db.Uuid
  taskInstanceId       String             @map("task_instance_id") @db.Uuid
  submissionVersion    Int                @map("submission_version")
  deploymentId         String             @map("deployment_id") @db.Uuid
  templateId           String             @map("template_id") @db.Uuid
  templateVersion      Int                @map("template_version")
  projectId            String             @map("project_id") @db.Uuid
  candidateId          String             @map("candidate_id") @db.Uuid
  externalTaskId       String             @unique @map("external_task_id")
  /// Frozen policy snapshot taken with this version (PRD-POLICY-RULES PR-T05); null when the project has no rule set.
  policySnapshotId     String?            @map("policy_snapshot_id") @db.Uuid
  title                String
  tptEstimate          String?            @map("tpt_estimate")
  executionMode        ExecutionMode      @map("execution_mode")
  taskJson             Json               @map("task_json")
  bundleRef            String             @map("bundle_ref")
  bundleSha256         String             @map("bundle_sha256")
  zeroBaselineScore    Decimal?           @map("zero_baseline_score") @db.Decimal(4, 2)
  oracleScore          Decimal?           @map("oracle_score") @db.Decimal(4, 2)
  verificationEvidence Json?              @map("verification_evidence")
  dataClassification   DataClassification @map("data_classification")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  taskInstance TaskInstance     @relation(fields: [taskInstanceId], references: [id])
  deployment   StudioDeployment @relation(fields: [deploymentId], references: [id])
  template     Template         @relation(fields: [templateId], references: [id])
  project      Project          @relation(fields: [projectId], references: [id])
  candidate    Candidate        @relation(fields: [candidateId], references: [id])

  @@unique([taskInstanceId, submissionVersion])
  @@index([clientId, createdAt])
  @@index([clientId, deploymentId])
}

// ── Policy Rules (docs/prd/PRD-POLICY-RULES.md, docs/architecture/ARCH-POLICY-RULES.md) ──

enum PolicyDocumentOrigin {
  UPLOAD
  MANUAL_TEXT
  SEED
  /// Accepted from an SME's policy proposal (authoring v2.1 Wave 3).
  SME_PROPOSAL
}

enum PolicyProposalStatus {
  PENDING
  ACCEPTED
  RETURNED
  REJECTED
}

/// docs/authoring/handover-v2/07: source categories, not a hierarchy.
enum PolicyProposalCategory {
  BANK_POLICY
  CUSTOMER_POLICY
  REGULATION
  SUPPORTING_REFERENCE
}

/// The reviewer's qualification of a proposed document (chapter 07). A document-workflow outcome, not a task state.
enum PolicyQualification {
  POLICY_CANDIDATE
  SUPPORTING_REFERENCE
  UNRELATED
  UNREADABLE
  SENSITIVE
}

enum ExtractionStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
  UNCERTAIN
}

enum PolicyRuleState {
  DRAFT
  NEEDS_DEFINITION
  REVIEWED
  EXCLUDED
}

enum TaskPolicyChangeType {
  CLARIFICATION
  STRICTER
  EXEMPTION
}

/// Optional policy requirements of a template version (S1 P03). Copied into a project at creation.
model TemplatePolicyProfile {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String   @map("client_id") @db.Uuid
  templateId        String   @unique @map("template_id") @db.Uuid
  categories        Json     @default("[]")
  suggestedPatterns Json     @default("[]") @map("suggested_patterns")
  expectedEvidence  Json     @default("[]") @map("expected_evidence")
  updatedById       String   @map("updated_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
}

/// Template policy requirements as copied into a project (S1 J01, P02). Never changed by later template edits.
model ProjectPolicyRequirement {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String   @map("client_id") @db.Uuid
  projectId         String   @unique @map("project_id") @db.Uuid
  templateId        String   @map("template_id") @db.Uuid
  templateVersion   Int      @map("template_version")
  categories        Json     @default("[]")
  suggestedPatterns Json     @default("[]") @map("suggested_patterns")
  expectedEvidence  Json     @default("[]") @map("expected_evidence")
  createdAt         DateTime @default(now()) @map("created_at")
}

model PolicyDocument {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  title         String
  category      String?
  language      String?
  jurisdiction  String?
  effectiveFrom DateTime? @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  latestVersion Int       @default(0) @map("latest_version")
  createdById   String    @map("created_by_id")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  versions PolicyDocumentVersion[]

  @@index([clientId, projectId])
}

/// An SME's proposed policy document (authoring v2.1 Wave 3, handover chapter 07). Pending until an assigned Expert
/// (Validator) or the project's PM/Admin decides. Nothing in a proposal is authoritative: accepting it only adds a
/// project document version, whose rules still go through extraction, rule review and PM/Admin publication. The file
/// columns and a decision, once made, are immutable (trigger).
model PolicyProposal {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String                 @map("client_id") @db.Uuid
  projectId         String                 @map("project_id") @db.Uuid
  taskInstanceId    String?                @map("task_instance_id") @db.Uuid
  smeUserId         String                 @map("sme_user_id") @db.Uuid
  title             String
  category          PolicyProposalCategory
  issuer            String?
  versionLabel      String?                @map("version_label")
  language          String?
  jurisdiction      String?
  effectiveFrom     DateTime?              @map("effective_from") @db.Date
  effectiveTo       DateTime?              @map("effective_to") @db.Date
  /// Why the SME needs this document for their task.
  reason            String
  rightsDeclared    Boolean                @map("rights_declared")
  sha256            String
  fileName          String                 @map("file_name")
  mediaType         String                 @map("media_type")
  format            String?
  sizeBytes         Int                    @map("size_bytes")
  pageCount         Int                    @default(0) @map("page_count")
  storageKey        String                 @unique @map("storage_key")
  /// Praxis's text reading; null when the file could not be read (flag UNREADABLE).
  textStorageKey    String?                @map("text_storage_key")
  textChars         Int                    @default(0) @map("text_chars")
  /// Deterministic intake flags: [{ code, message }]. Advice to the reviewer only, never a decision.
  intakeFlags       Json                   @default("[]") @map("intake_flags")
  status            PolicyProposalStatus   @default(PENDING)
  qualification     PolicyQualification?
  decisionReason    String?                @map("decision_reason")
  decidedById       String?                @map("decided_by_id") @db.Uuid
  decidedRole       String?                @map("decided_role")
  decidedAt         DateTime?              @map("decided_at")
  documentId        String?                @map("document_id") @db.Uuid
  documentVersionId String?                @map("document_version_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@index([clientId, projectId, status])
  @@index([smeUserId, projectId])
}

/// Immutable document version (S1 E04). Append-only in the database.
model PolicyDocumentVersion {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String               @map("client_id") @db.Uuid
  projectId          String               @map("project_id") @db.Uuid
  documentId         String               @map("document_id") @db.Uuid
  version            Int
  sha256             String
  fileName           String               @map("file_name")
  mediaType          String               @map("media_type")
  format             String
  sizeBytes          Int                  @map("size_bytes")
  pageCount          Int                  @map("page_count")
  /// How the page count was obtained: pdf_pages | docx_app_xml | text_estimate.
  pageCountMethod    String               @map("page_count_method")
  storageKey         String               @unique @map("storage_key")
  textStorageKey     String               @map("text_storage_key")
  textChars          Int                  @map("text_chars")
  /// Locator granularity for citations: page | line | section | none (S1 E07).
  locatorGranularity String               @map("locator_granularity")
  origin             PolicyDocumentOrigin
  uploadedById       String               @map("uploaded_by_id")
  createdAt          DateTime             @default(now()) @map("created_at")

  document  PolicyDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  jobs      ExtractionJob[]
  citations PolicyCitation[]

  @@unique([documentId, version])
  @@index([clientId, projectId])
}

/// Allowlisted extraction profile (S2 §2). Only Admins change it; each change bumps the revision.
model ExtractionProfile {
  /// Allowlisted profile ID (e.g. llama-agentic-v1); the same built-in IDs exist once per client.
  id          String
  clientId    String   @map("client_id") @db.Uuid
  provider    String
  label       String
  enabled     Boolean  @default(false)
  revision    Int      @default(1)
  config      Json
  isDefault   Boolean  @default(false) @map("is_default")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([clientId, id])
}

/// Project-level extraction profile chosen by an Admin (S2 §2 precedence).
model ProjectExtractionSetting {
  projectId   String   @id @map("project_id") @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  profileId   String   @map("profile_id")
  updatedById String   @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")
}

model ExtractionBatch {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String           @map("client_id") @db.Uuid
  projectId       String           @map("project_id") @db.Uuid
  /// tenant + project + sorted document hashes + profile revision + schema/prompt hashes + attempt token (S2 §7).
  idempotencyKey  String           @unique @map("idempotency_key")
  profileId       String           @map("profile_id")
  profileRevision Int              @map("profile_revision")
  profileSnapshot Json             @map("profile_snapshot")
  selectionSource String           @map("selection_source")
  schemaHash      String           @map("schema_hash")
  promptHash      String           @map("prompt_hash")
  parentBatchId   String?          @map("parent_batch_id") @db.Uuid
  status          ExtractionStatus @default(QUEUED)
  requestedById   String           @map("requested_by_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  finishedAt      DateTime?        @map("finished_at")

  jobs ExtractionJob[]

  @@index([clientId, projectId, createdAt])
}

model ExtractionJob {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId            String           @map("client_id") @db.Uuid
  batchId             String           @map("batch_id") @db.Uuid
  documentVersionId   String           @map("document_version_id") @db.Uuid
  provider            String
  providerOperationId String?          @map("provider_operation_id")
  status              ExtractionStatus @default(QUEUED)
  attempt             Int              @default(1)
  error               String?
  rawReceiptKey       String?          @map("raw_receipt_key")
  usage               Json?
  candidateCount      Int              @default(0) @map("candidate_count")
  estimatedUsd        Decimal          @default(0) @map("estimated_usd") @db.Decimal(10, 4)
  actualUsd           Decimal?         @map("actual_usd") @db.Decimal(10, 4)
  cleanup             String?
  startedAt           DateTime?        @map("started_at")
  finishedAt          DateTime?        @map("finished_at")
  createdAt           DateTime         @default(now()) @map("created_at")

  batch           ExtractionBatch       @relation(fields: [batchId], references: [id])
  documentVersion PolicyDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@unique([batchId, documentVersionId])
}

/// Spend ledger (S2 §11, D-B1). Append-only; the ceiling is cumulative per provider.
model ExtractionSpend {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  provider  String
  jobId     String   @map("job_id") @db.Uuid
  kind      String
  amountUsd Decimal  @map("amount_usd") @db.Decimal(10, 4)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([provider])
}

model PolicyRule {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String   @map("client_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  /// Human-readable stable key, e.g. R-APPROVAL. Unique per project.
  ruleKey       String   @map("rule_key")
  /// Rule ID proposed by the source (before de-duplication); the same sourceKey with different content is a conflict (PR-R10).
  sourceKey     String?  @map("source_key")
  latestVersion Int      @default(1) @map("latest_version")
  required      Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  versions PolicyRuleVersion[]

  @@unique([projectId, ruleKey])
  @@index([clientId, projectId])
  @@index([projectId, sourceKey])
}

/// A rule version. Editable only while DRAFT or NEEDS_DEFINITION; REVIEWED and EXCLUDED are immutable (trigger).
model PolicyRuleVersion {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String          @map("client_id") @db.Uuid
  ruleId          String          @map("rule_id") @db.Uuid
  version         Int
  state           PolicyRuleState @default(DRAFT)
  /// Canonical rule body (packages/shared/src/policy/schema.ts PolicyRuleBody).
  body            Json
  contentHash     String          @map("content_hash")
  extractionJobId String?         @map("extraction_job_id") @db.Uuid
  origin          String
  editedById      String          @map("edited_by_id")
  reviewedById    String?         @map("reviewed_by_id")
  reviewedAt      DateTime?       @map("reviewed_at")
  excludeReason   String?         @map("exclude_reason")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  rule      PolicyRule       @relation(fields: [ruleId], references: [id])
  citations PolicyCitation[]

  @@unique([ruleId, version])
}

model PolicyCitation {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String   @map("client_id") @db.Uuid
  ruleVersionId     String   @map("rule_version_id") @db.Uuid
  documentVersionId String   @map("document_version_id") @db.Uuid
  fieldPath         String   @map("field_path")
  /// supports | qualifies | exception | conflict
  role              String
  quote             String
  /// { kind: page_region | text_span | manual_reference, page?, lineStart?, lineEnd?, charStart?, charEnd?, section?, chunkId? }
  locator           Json
  /// RESOLVED | QUOTE_MISMATCH | UNRESOLVED
  resolution        String
  providerRaw       Json?    @map("provider_raw")
  confirmedById     String?  @map("confirmed_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  ruleVersion     PolicyRuleVersion     @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)
  documentVersion PolicyDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@index([ruleVersionId])
}

/// Immutable published Project rule set (S1 R14). Append-only.
model ProjectRuleSet {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  version         Int
  inheritanceMode String   @default("ALL_TASKS") @map("inheritance_mode")
  ruleVersionIds  String[] @map("rule_version_ids")
  excluded        Json     @default("[]")
  content         Json
  digest          String
  publishedById   String   @map("published_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([projectId, version])
  @@index([projectId, digest])
}

model TaskPolicyChange {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String               @map("client_id") @db.Uuid
  taskInstanceId   String               @map("task_instance_id") @db.Uuid
  ruleVersionId    String               @map("rule_version_id") @db.Uuid
  type             TaskPolicyChangeType
  scope            Json
  requirement      String
  reason           String
  sourceCitationId String?              @map("source_citation_id") @db.Uuid
  exceptionIndex   Int?                 @map("exception_index")
  createdById      String               @map("created_by_id")
  deletedAt        DateTime?            @map("deleted_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([taskInstanceId])
}

/// Frozen effective policy of a task version (S1 T09/T10). Append-only.
model TaskPolicySnapshot {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  taskInstanceId String   @map("task_instance_id") @db.Uuid
  version        Int
  ruleSetId      String   @map("rule_set_id") @db.Uuid
  content        Json
  rubricVersion  String   @map("rubric_version")
  digest         String
  publishedById  String   @map("published_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([taskInstanceId, version])
  @@index([taskInstanceId, digest])
}
