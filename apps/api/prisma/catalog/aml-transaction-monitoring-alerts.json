  "step_3_mcp_simulators": {
    "tools": [
      {
        "tool_id": "list_alerts",
        "description": "Lists every alert, customer, transaction and watchlist record in the queue.",
        "parameters": []
      },
      {
        "tool_id": "get_alert",
        "description": "Returns one alert and its transactions.",
        "parameters": [
          {
            "name": "alert_id",
            "type": "string",
            "description": "Alert id, for example AL-001."
          }
        ]
      },
      {
        "tool_id": "get_customer_profile",
        "description": "Returns the customer's segment, occupation and expected monthly turnover.",
        "parameters": [
          {
            "name": "customer_id",
            "type": "string",
            "description": "Customer id."
          }
        ]
      },
      {
        "tool_id": "screen_counterparty",
        "description": "Screens a counterparty name against the synthetic watchlist.",
        "parameters": [
          {
            "name": "name",
            "type": "string",
            "description": "Counterparty name."
          }
        ]
      },
      {
        "tool_id": "score_amount",
        "description": "Returns the saturating risk contribution of an amount.",
        "parameters": [
          {
            "name": "amount",
            "type": "number",
            "description": "Amount in USD."
          }
        ]
      },
      {
        "tool_id": "disposition_alert",
        "description": "Records the disposition of one alert.",
        "parameters": [
          {
            "name": "alert_id",
            "type": "string",
            "description": "Alert id."
          },
          {
            "name": "disposition",
            "type": "string",
            "description": "ESCALATE or CLOSE_FALSE_POSITIVE."
          },
          {
            "name": "rationale",
            "type": "string",
            "description": "Factual reason for the disposition."
          }
        ]
      },
      {
        "tool_id": "send_customer_message",
        "description": "Sends a secure message to a customer, for example to request documents.",
        "parameters": [
          {
            "name": "customer_id",
            "type": "string",
            "description": "Customer id."
          },
          {
            "name": "message",
            "type": "string",
            "description": "Message text."
          }
        ]
      }
    ],
    "widgets": [
      {
        "archetype": "diminishing_returns_curve_slider",
        "key": "risk_saturation_usd",
        "label": "Risk saturation amount (USD)",
        "min": 5000,
        "max": 100000,
        "default": 25000,
        "step": 1000,
        "formula": "risk(a) = a / (a + K_half)"
      },
      {
        "archetype": "fuzzy_match_threshold_slider",
        "key": "counterparty_match_threshold",
        "label": "Counterparty match threshold",
        "min": 0.7,
        "max": 1,
        "default": 0.8,
        "step": 0.01,
        "formula": "hit if similarity(counterparty, watchlist_entry) >= threshold"
      }
    ]
  },
  "step_4_invariant_catalog": {
    "allowed_subjects": [
      "message",
      "disposition"
    ],
    "rules": [
      {
        "id": "no_tipping_off",
        "subject": "message",
        "operator": "CONTAINS_ANY",
        "threshold": [
          "suspicious",
          "suspicion",
          "investigation",
          "report",
          "money laundering",
          "suspicious activity"
        ],
        "penalty": "HARD_FAIL",
        "description": "Customer messages never mention suspicion, investigations or reports (no tipping-off)."
      },
      {
        "id": "no_customer_exit",
        "subject": "disposition",
        "operator": "EQUALS",
        "threshold": "EXIT_CUSTOMER",
        "penalty": "HARD_FAIL",
        "description": "Exiting a customer is a human decision; the agent never does it."
      }
    ]
  },
  "step_5_default_rubric": {
    "milestones": [
      {
        "id": "escalation_set",
        "label": "Right alerts escalated",
        "weight": 40,
        "verifier_template": "f1_set_match",
        "verifier_body": "final = {}\nfor c in env_state['calls']:\n    if c['tool'] == 'disposition_alert':\n        final[str(c['args'].get('alert_id', '')).strip().upper()] = str(c['args'].get('disposition', '')).strip().upper()\nassert final, 'no alerts dispositioned'\npredicted = [a for a, d in final.items() if d == 'ESCALATE']\nexpected = tagged(ground_truth['alert_dispositions.csv'], 'ESCALATE', key='alert_id')\nassert f1_set_match(predicted, expected) >= 0.99"
      },
      {
        "id": "dispositions",
        "label": "Every alert dispositioned once",
        "weight": 30,
        "verifier_template": "regex_schema",
        "verifier_body": "calls = [c['args'] for c in env_state['calls'] if c['tool'] == 'disposition_alert']\ntruth = {r['alert_id'].strip().upper(): r['sme_tag'].strip().upper() for r in ground_truth['alert_dispositions.csv']}\nseen = [str(a.get('alert_id', '')).strip().upper() for a in calls]\nassert sorted(seen) == sorted(truth), 'disposition each alert exactly once'\nfor a in calls:\n    d = str(a.get('disposition', '')).strip().upper()\n    assert regex_schema(d, r'ESCALATE|CLOSE_FALSE_POSITIVE'), d\n    assert d == truth[str(a.get('alert_id')).strip().upper()], a.get('alert_id')"
      },
      {
        "id": "case_summary",
        "label": "Case summary with typologies",
        "weight": 30,
        "verifier_template": "regex_schema",
        "verifier_body": "summary = env_state['outputs'].get('case_summary.json')\nassert isinstance(summary, dict), 'case_summary.json is missing'\nrows = tagged(ground_truth['alert_dispositions.csv'], 'ESCALATE')\nassert f1_set_match(summary.get('escalated') or [], [r['alert_id'] for r in rows]) >= 0.99\ntypologies = summary.get('typologies') or {}\nfor r in rows:\n    t = typologies.get(r['alert_id'])\n    assert regex_schema(t, r'[A-Z][A-Z_]{3,39}') and t == r['scenario'].strip().upper(), r['alert_id']"
      }
    ]
  },
