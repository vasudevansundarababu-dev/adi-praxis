# Copy to .env for local dev. Never commit real secrets.
# local | staging | production (staging accepts Stripe test-mode identity; production requires live)
APP_ENV=local

# --- Database (docker-compose defaults) ---
DATABASE_URL=postgresql://praxis:praxis@localhost:5442/praxis
TEST_DATABASE_URL=postgresql://praxis:praxis@localhost:5442/praxis_test

# --- Redis ---
REDIS_URL=redis://localhost:6389

# --- API ---
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Allowed browser origins for the console and candidate apps (comma separated)
CORS_ORIGINS=http://localhost:3100,http://localhost:3101
# Internal-user session lifetime in hours
SESSION_TTL_HOURS=12
# Set to true behind HTTPS so session cookies are Secure
COOKIE_SECURE=false

# --- Seed: first Admin account (local dev only) ---
SEED_ADMIN_EMAIL=admin@praxis.local
SEED_ADMIN_PASSWORD=change-me-locally-please
SEED_CLIENT_NAME=ADI-Labs
# Template catalog source (defaults to docs/Taskflow.xlsx)
TASKFLOW_PATH=

# --- Email (Mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1035
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="ADI Praxis <no-reply@praxis.local>"

# --- Storage (fake-gcs-server locally) ---
GCS_EMULATOR_HOST=http://localhost:4443
GCS_PROJECT_ID=praxis-local

# --- Candidate app ---
CANDIDATE_APP_URL=http://localhost:3101
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- External services (mocked in local dev and tests when blank; production requires them) ---
# Candidate Google sign-in: blank = local "Dev sign-in (mock Google)" screen
GOOGLE_OAUTH_CLIENT_ID=
# Stripe Identity: blank = local mock with a dev simulation panel
STRIPE_SECRET_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=
# Signs local-dev mock credentials and webhooks; never used in production
MOCK_SECRET=local-dev-mock-secret-not-for-production
# SME profile assistant (Claude via Vertex AI). Blank = local heuristic mock; production requires it.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
# Near-duplicate detection embeddings (Vertex AI text embeddings; same project). Blank project = local hashing mock.
EMBEDDING_LOCATION=us-central1
EMBEDDING_MODEL=text-embedding-005
# Nightly hash-chain verification of the append-only dataset (UTC cron)
DATASET_VERIFY_CRON=0 3 * * *
# FLOW 4: results to RL Gym by signed webhook (blank URL = RL Gym pulls results with its API key)
RL_GYM_WEBHOOK_URL=
RL_GYM_WEBHOOK_SECRET=
EVIDENCE_BUCKET=praxis-evidence

# M10 SME supply (docs/SME-SUPPLY.md). Off by default.
SME_SUPPLY_ENABLED=false
# 32 random bytes, base64 (openssl rand -base64 32). Required in production when M10 is on.
M10_ENCRYPTION_KEY=
PARTNER_API_TOKEN_TTL_SECONDS=3600
