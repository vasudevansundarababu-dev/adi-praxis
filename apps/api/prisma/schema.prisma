// ADI Praxis data model (M0).
// Sources: docs/SPEC.md "Data model" and docs/FLOW2-SME.md section 11 (FLOW2 wins on candidate records).
// Conventions: UUID ids generated in the database, created_at/updated_at on every mutable table,
// client_id on every table (single client in v1, multi-tenant later).
// Append-only tables (ApprovedTaskRecord, RLReviewRecord, AuditEvent, SelectionDecision) have no updatedAt;
// database-level enforcement (roles + triggers) lands in M6.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ───────────────────────────── Enums ─────────────────────────────

enum InternalRole {
  ADMIN
  PM
  REVIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SessionAudience {
  INTERNAL
  CANDIDATE
}

enum ActorType {
  USER
  CANDIDATE
  SYSTEM
  SERVICE
}

enum DomainStatus {
  ACTIVE
  RETIRED
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum TaskMode {
  AUTHORING
  ANNOTATION
}

enum TaskType {
  AUTHORING
  ANNOTATION
  RL_REVIEW
}

enum DemographicAttributeType {
  SINGLE_SELECT
  MULTI_SELECT
  NUMBER_RANGE
  GEO_RADIUS
  LANGUAGE_PROFICIENCY
}

enum FilterOperator {
  IN
  GTE
  LTE
  BETWEEN
  WITHIN_RADIUS
}

enum LocationType {
  REMOTE
  ONSITE
  HYBRID
}

enum ProjectStatus {
  DRAFT
  READY_FOR_STAFFING
  STAFFING
  STAFFED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignChannel {
  LINKEDIN_MANUAL
  LINKEDIN_APPLY_CONNECT
}

enum CampaignStatus {
  DRAFT
  LIVE
  PAUSED
  CLOSED
}

enum TaskInstanceStatus {
  CREATED
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  ACCEPTED
  REWORK
  /// TASK-KYC R03: rejected (duplicate, not realistic, incorrect, real data). Terminal; the slot is released.
  REJECTED
}

enum TaskReviewDecision {
  ACCEPT
  REWORK
  REJECT
}

enum TaskRejectReason {
  DUPLICATE
  NOT_REALISTIC
  INCORRECT
  REAL_DATA
}

enum InviteChannel {
  EMAIL
  SMS
}

enum InputSource {
  UPLOAD
  API
}

enum CoverageSlotStatus {
  OPEN
  OFFERED
  IN_PROGRESS
  FILLED
  RELEASED
}

enum SimilarityMethod {
  EMBEDDING
  STRUCTURED
}

enum DuplicateDecision {
  ACCEPT_AS_DISTINCT
  REWORK
  REJECT_DUPLICATE
}

enum RLVerdict {
  PASS
  FAIL
  NEEDS_EXPERT
}

enum RLReviewRequestStatus {
  RECEIVED
  IN_REVIEW
  COMPLETED
}

enum ApiClientKind {
  CLIENT_API
  RL_GYM
}

// FLOW2 section 10: independent candidate state dimensions.

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum IdentityStatus {
  NOT_STARTED
  REQUIRES_INPUT
  PROCESSING
  VERIFIED
  CANCELED
  MANUAL_REVIEW_REQUIRED
  ALTERNATIVE_VERIFIED
}

enum ProfileConversationStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_TO_CONFIRM
  SUBMITTED
  AMENDMENT_PENDING
}

enum SuitabilityStatus {
  NOT_RUN
  EVALUATING
  FIT_RECOMMENDED
  NOT_FIT_RECOMMENDED
  NEEDS_INFORMATION
  ERROR
  SUPERSEDED
}

enum EnrollmentStatus {
  DRAFT
  SUBMITTED
  NEEDS_INFORMATION
  REVIEW_PENDING
  SELECTED
  NOT_SELECTED
  REVIEW_REQUESTED
  WITHDRAWN
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  BLOCKED
}

enum SmeAssignmentStatus {
  PROPOSED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELED
  HANDED_OFF
}

enum SelectionOutcome {
  SELECTED
  NOT_SELECTED
  NEEDS_INFORMATION
}

enum EvidenceLevel {
  SELF_REPORTED
  DOCUMENT_SUPPORTED
  INDEPENDENTLY_VERIFIED
  INCONCLUSIVE
  CONTRADICTED
  EXPIRED
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AuthProvider {
  GOOGLE
  APPLE
}

enum Speaker {
  CANDIDATE
  ASSISTANT
  SYSTEM
}

enum ContributionRole {
  TASK_AUTHOR
  ANNOTATOR
  REVIEWER
  RUBRIC_DESIGNER
  SCENARIO_VALIDATOR
}

enum DatePrecision {
  MONTH
  YEAR
  APPROXIMATE
}

// ───────────────────────── Tenancy and internal users ─────────────────────────

model Client {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users    User[]
  domains  Domain[]
  projects Project[]
}

/// Internal users: Admin, PM, Reviewer. One user may hold several roles.
model User {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String         @map("client_id") @db.Uuid
  email        String         @unique
  name         String
  roles        InternalRole[]
  status       UserStatus     @default(ACTIVE)
  passwordHash String         @map("password_hash")
  lastLoginAt  DateTime?      @map("last_login_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  client        Client        @relation(fields: [clientId], references: [id])
  sessions      Session[]
  ownedProjects Project[]     @relation("ProjectOwner")
  reviewing     ProjectReviewer[]

  @@index([clientId])
}

/// Server-side sessions. Internal users now; candidates (separate audience) from M4.
model Session {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId   String          @map("client_id") @db.Uuid
  audience   SessionAudience
  userId     String?         @map("user_id") @db.Uuid
  smeUserId  String?         @map("sme_user_id") @db.Uuid
  tokenHash  String          @unique @map("token_hash")
  expiresAt  DateTime        @map("expires_at")
  revokedAt  DateTime?       @map("revoked_at")
  ip         String?
  userAgent  String?         @map("user_agent")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  user    User?    @relation(fields: [userId], references: [id])
  smeUser SmeUser? @relation(fields: [smeUserId], references: [id])

  @@index([userId])
  @@index([smeUserId])
}

/// Service-to-service callers: client API push (task inputs) and RL Gym.
model ApiClient {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String        @map("client_id") @db.Uuid
  name      String
  kind      ApiClientKind
  keyHash   String        @unique @map("key_hash")
  revokedAt DateTime?     @map("revoked_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([clientId])
}

// ───────────────────────────── Template catalog ─────────────────────────────

model Domain {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String       @map("client_id") @db.Uuid
  name      String
  status    DomainStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  client    Client     @relation(fields: [clientId], references: [id])
  templates Template[]

  @@unique([clientId, name])
}

/// A Workflow template. Editing a published template creates a new row with the same lineageId and version + 1.
model Template {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId              String         @map("client_id") @db.Uuid
  domainId              String         @map("domain_id") @db.Uuid
  lineageId             String         @map("lineage_id") @db.Uuid
  version               Int            @default(1)
  workflowName          String         @map("workflow_name")
  primaryWork           String?        @map("primary_work")
  verificationCriteria  String?        @map("verification_criteria")
  humanGate             String?        @map("human_gate")
  /// Opaque in v1: defined by the separate per-workflow task definition spec.
  taskDefinitionSchema  Json           @default("{}") @map("task_definition_schema")
  /// Opaque in v1: defined by the separate per-workflow task definition spec.
  collectionSchema      Json           @default("{}") @map("collection_schema")
  defaultTptMinutes     Int?           @map("default_tpt_minutes")
  defaultJdId           String?        @map("default_jd_id") @db.Uuid
  skills                String[]
  status                TemplateStatus @default(DRAFT)
  taskModes             TaskMode[]     @map("task_modes")
  /// dimension -> allowed values, required cells and quotas
  coverageDimensions    Json           @default("{}") @map("coverage_dimensions")
  /// [{ name, description, quota, required }]
  edgeCaseCatalog       Json           @default("[]") @map("edge_case_catalog")
  defaultDistinctTarget Int            @default(50) @map("default_distinct_target")
  defaultMaxPerExpert   Int            @default(4) @map("default_max_per_expert")
  openSlotShare         Decimal        @default(0.2) @map("open_slot_share") @db.Decimal(4, 3)
  similarityThreshold   Decimal        @default(0.90) @map("similarity_threshold") @db.Decimal(4, 3)
  publishedAt           DateTime?      @map("published_at")
  retiredAt             DateTime?      @map("retired_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  domain    Domain          @relation(fields: [domainId], references: [id])
  defaultJd JobDescription? @relation("TemplateDefaultJd", fields: [defaultJdId], references: [id])
  projects  Project[]

  @@unique([lineageId, version])
  @@index([clientId, status])
}

model DemographicAttribute {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String                   @map("client_id") @db.Uuid
  key           String
  label         String
  type          DemographicAttributeType
  allowedValues Json                     @default("[]") @map("allowed_values")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  @@unique([clientId, key])
}

// ───────────────────────────── FLOW 1: projects ─────────────────────────────

model JobDescription {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String       @map("client_id") @db.Uuid
  title            String
  /// Lower-cased, whitespace-collapsed title for FLOW 2 JD lookup.
  normalizedTitle  String       @map("normalized_title")
  responsibilities String
  skills           String[]
  wagePerTask      Decimal      @map("wage_per_task") @db.Decimal(12, 2)
  wageCurrency     String       @map("wage_currency") @db.Char(3)
  locationType     LocationType @map("location_type")
  location         String?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  templatesAsDefault Template[]               @relation("TemplateDefaultJd")
  projects           Project[]
  snapshots          JobDescriptionSnapshot[]
  campaigns          Campaign[]

  @@index([clientId, normalizedTitle])
}

/// Frozen copy of a JD at project submit; ApprovedTaskRecord.jd_snapshot_id points here.
model JobDescriptionSnapshot {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String   @map("client_id") @db.Uuid
  jobDescriptionId String   @map("job_description_id") @db.Uuid
  data             Json
  createdAt        DateTime @default(now()) @map("created_at")

  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id])
  projects       Project[]
}

model Project {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId               String        @map("client_id") @db.Uuid
  ownerId                String        @map("owner_id") @db.Uuid
  templateId             String        @map("template_id") @db.Uuid
  templateVersion        Int           @map("template_version")
  jobDescriptionId       String?       @map("job_description_id") @db.Uuid
  jdSnapshotId           String?       @map("jd_snapshot_id") @db.Uuid
  name                   String
  description            String?
  status                 ProjectStatus @default(DRAFT)
  taskMode               TaskMode      @default(AUTHORING) @map("task_mode")
  /// Annotation projects: number of task instances.
  taskCount              Int?          @map("task_count")
  /// Authoring projects: distinct-task target and per-expert cap.
  distinctTarget         Int?          @map("distinct_target")
  maxPerExpert           Int?          @map("max_per_expert")
  openSlotShare          Decimal?      @map("open_slot_share") @db.Decimal(4, 3)
  /// PM-raised coverage quotas (never below the template minimum).
  coverageQuotas         Json?         @map("coverage_quotas")
  tptMinutes             Int?          @map("tpt_minutes")
  hoursPerWorkerDay      Decimal       @default(4) @map("hours_per_worker_day") @db.Decimal(4, 2)
  startDate              DateTime?     @map("start_date") @db.Date
  endDate                DateTime?     @map("end_date") @db.Date
  requiredWorkers        Int?          @map("required_workers")
  /// Computed fields frozen at submit: tasks, requiredAuthors, totalEffortHours, workingDays, labourBudget.
  figures                Json?
  demographicsSnapshot   Json?         @map("demographics_snapshot")
  autoLaunchCampaign     Boolean       @default(false) @map("auto_launch_campaign")
  openTaskCapPerCandidate Int          @default(3) @map("open_task_cap_per_candidate")
  submittedAt            DateTime?     @map("submitted_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  client             Client                    @relation(fields: [clientId], references: [id])
  owner              User                      @relation("ProjectOwner", fields: [ownerId], references: [id])
  template           Template                  @relation(fields: [templateId], references: [id])
  jobDescription     JobDescription?           @relation(fields: [jobDescriptionId], references: [id])
  jdSnapshot         JobDescriptionSnapshot?   @relation(fields: [jdSnapshotId], references: [id])
  demographicFilters ProjectDemographicFilter[]
  campaigns          Campaign[]
  assignments        ProjectAssignment[]
  tasks              TaskInstance[]
  slots              CoverageSlot[]
  inputBatches       TaskInputBatch[]
  opportunity        Opportunity?
  reviewers          ProjectReviewer[]
  matches            ProjectMatch[]
  matchRejections    ProjectMatchRejection[]
  /// When the last FLOW 2 match run finished.
  matchedAt          DateTime?                 @map("matched_at")

  @@unique([clientId, name])
  @@index([ownerId])
  @@index([status])
}

model ProjectDemographicFilter {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String         @map("client_id") @db.Uuid
  projectId    String         @map("project_id") @db.Uuid
  attributeKey String         @map("attribute_key")
  operator     FilterOperator
  values       Json
  required     Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ───────────────────────── FLOW 2: matching and sourcing ─────────────────────────

/// Thin matching record for an SME user; fields copied from the latest confirmed profile (FLOW2-SME section 11).
/// Typed columns so FLOW 2 hard filters run in SQL. Unknown values stay null: never guessed, never defaulted.
model Candidate {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId               String    @map("client_id") @db.Uuid
  smeUserId              String    @unique @map("sme_user_id") @db.Uuid
  latestProfileVersionId String?   @map("latest_profile_version_id") @db.Uuid
  poolStatus             String?   @map("pool_status")
  /// ISO 3166-1 alpha-2
  country                String?   @db.Char(2)
  city                   String?
  latitude               Float?
  longitude              Float?
  /// [{ language: ISO 639-1, level: CEFR or NATIVE }]
  languages              Json      @default("[]")
  specialties            String[]
  jurisdictions          String[]
  skills                 String[]
  domainExperienceYears  Float?    @map("domain_experience_years")
  /// ISCED level key, e.g. ISCED_6
  educationLevel         String?   @map("education_level")
  hoursPerWeek           Int?      @map("hours_per_week")
  /// IANA time zone
  timezone               String?
  /// Values for Admin-added taxonomy attributes, keyed by attribute key.
  attributes             Json      @default("{}")
  lastValidatedAt        DateTime? @map("last_validated_at")
  concurrentProjectLimit Int       @default(2) @map("concurrent_project_limit")
  deletedAt              DateTime? @map("deleted_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  smeUser      SmeUser                  @relation(fields: [smeUserId], references: [id])
  applications Application[]
  assignments  ProjectAssignment[]
  tasks        TaskInstance[]
  matches      ProjectMatch[]
  rejections   ProjectMatchRejection[]

  @@index([clientId])
  @@index([country])
  @@index([specialties], type: Gin)
}

/// Stored FLOW 2 match results for a project, replaced on each (re-)run so the list stays stable between runs.
model ProjectMatch {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  candidateId String   @map("candidate_id") @db.Uuid
  rank        Int
  score       Decimal  @db.Decimal(6, 2)
  /// Per-part scores and which preferred filters matched.
  breakdown   Json
  computedAt  DateTime @map("computed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project   Project   @relation(fields: [projectId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@unique([projectId, candidateId])
  @@index([projectId, rank])
}

/// A PM's decision not to use a candidate for one project. Not a global exclusion.
model ProjectMatchRejection {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  candidateId  String   @map("candidate_id") @db.Uuid
  reason       String?
  rejectedById String   @map("rejected_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project   Project   @relation(fields: [projectId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@unique([projectId, candidateId])
}

model Campaign {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String          @map("client_id") @db.Uuid
  projectId        String          @map("project_id") @db.Uuid
  jobDescriptionId String          @map("job_description_id") @db.Uuid
  channel          CampaignChannel
  externalId       String?         @map("external_id")
  status           CampaignStatus  @default(DRAFT)
  budget           Decimal?        @db.Decimal(12, 2)
  postText         String?         @map("post_text")
  applyUrl         String?         @map("apply_url")
  /// Tracked apply-link clicks (other metrics are derived from applications and enrollments).
  clicks           Int             @default(0)
  startAt          DateTime?       @map("start_at")
  endAt            DateTime?       @map("end_at")
  /// clicks, applies, kyc_completed, approved, assigned
  metrics          Json            @default("{}")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  project        Project        @relation(fields: [projectId], references: [id])
  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id])
  applications   Application[]

  @@index([projectId])
}

/// Campaign attribution only; status lives on the SME Enrollment.
model Application {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String          @map("client_id") @db.Uuid
  campaignId   String          @map("campaign_id") @db.Uuid
  candidateId  String?         @map("candidate_id") @db.Uuid
  enrollmentId String?         @map("enrollment_id") @db.Uuid
  source       CampaignChannel
  appliedAt    DateTime        @default(now()) @map("applied_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  campaign   Campaign    @relation(fields: [campaignId], references: [id])
  candidate  Candidate?  @relation(fields: [candidateId], references: [id])
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id])

  @@unique([campaignId, enrollmentId])
}

/// Candidate x Project. Validation, selection and acceptance state live on the SME enrollment and assignment.
model ProjectAssignment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String    @map("client_id") @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  candidateId     String    @map("candidate_id") @db.Uuid
  matchScore      Decimal?  @map("match_score") @db.Decimal(6, 2)
  enrollmentId    String?   @map("enrollment_id") @db.Uuid
  smeAssignmentId String?   @unique @map("sme_assignment_id") @db.Uuid
  assignedAt      DateTime  @default(now()) @map("assigned_at")
  releasedAt      DateTime? @map("released_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  project       Project        @relation(fields: [projectId], references: [id])
  candidate     Candidate      @relation(fields: [candidateId], references: [id])
  enrollment    Enrollment?    @relation(fields: [enrollmentId], references: [id])
  smeAssignment SmeAssignment? @relation(fields: [smeAssignmentId], references: [id])
  invites       Invite[]
  tasks         TaskInstance[]

  @@unique([projectId, candidateId])
}

// ───────────────────── FLOW 3: tasks, slots, invites ─────────────────────

/// Every submitted version of a task (rework keeps history; the Reviewer sees what changed). Append-only.
model TaskSubmission {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  taskInstanceId String   @map("task_instance_id") @db.Uuid
  version        Int
  output         Json
  coverageTags   Json?    @map("coverage_tags")
  checks         Json?
  submittedAt    DateTime @default(now()) @map("submitted_at")

  taskInstance TaskInstance @relation(fields: [taskInstanceId], references: [id])

  @@unique([taskInstanceId, version])
}

/// A Reviewer's decision on a submitted task (TASK-KYC R03), with the completed checklist. Append-only.
model TaskReview {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String             @map("client_id") @db.Uuid
  taskInstanceId    String             @map("task_instance_id") @db.Uuid
  submissionVersion Int                @map("submission_version")
  reviewerId        String             @map("reviewer_id") @db.Uuid
  decision          TaskReviewDecision
  rejectReason      TaskRejectReason?  @map("reject_reason")
  duplicateDecision DuplicateDecision? @map("duplicate_decision")
  checklist         Json
  /// Comments pinned to workbench sections: [{ section, text }]
  comments          Json               @default("[]")
  notes             String?
  createdAt         DateTime           @default(now()) @map("created_at")

  taskInstance TaskInstance @relation(fields: [taskInstanceId], references: [id])

  @@index([taskInstanceId])
}

model CoverageSlot {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String             @map("client_id") @db.Uuid
  projectId    String             @map("project_id") @db.Uuid
  /// dimension values + edge case
  coverageTags Json               @map("coverage_tags")
  isOpen       Boolean            @default(false) @map("is_open")
  /// Counts towards minimum coverage; offered first.
  required     Boolean            @default(false)
  /// Generation order, for stable offering.
  position     Int                @default(0)
  brief        String
  status       CoverageSlotStatus @default(OPEN)
  assignedToId String?            @map("assigned_to_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  project Project        @relation(fields: [projectId], references: [id])
  tasks   TaskInstance[]

  @@index([projectId, status])
}

model TaskInputBatch {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String      @map("client_id") @db.Uuid
  projectId    String      @map("project_id") @db.Uuid
  source       InputSource
  uploadedById String?     @map("uploaded_by_id") @db.Uuid
  apiClientId  String?     @map("api_client_id") @db.Uuid
  itemCount    Int         @map("item_count")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  project Project        @relation(fields: [projectId], references: [id])
  tasks   TaskInstance[]
}

model TaskInstance {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId            String             @map("client_id") @db.Uuid
  projectId           String             @map("project_id") @db.Uuid
  taskType            TaskType           @map("task_type")
  slotId              String?            @map("slot_id") @db.Uuid
  inputBatchId        String?            @map("input_batch_id") @db.Uuid
  rlReviewRequestId   String?            @unique @map("rl_review_request_id") @db.Uuid
  input               Json               @default("{}")
  output              Json?
  status              TaskInstanceStatus @default(CREATED)
  /// Optimistic-concurrency revision for state changes.
  revision            Int                @default(0)
  assignedToId        String?            @map("assigned_to_id") @db.Uuid
  projectAssignmentId String?            @map("project_assignment_id") @db.Uuid
  assignedAt          DateTime?          @map("assigned_at")
  startedAt           DateTime?          @map("started_at")
  submittedAt         DateTime?          @map("submitted_at")
  activeSeconds       Int                @default(0) @map("active_seconds")
  reviewerId          String?            @map("reviewer_id") @db.Uuid
  reviewNotes         String?            @map("review_notes")
  reworkCount         Int                @default(0) @map("rework_count")
  /// Final coverage: the slot's fixed tags plus the author's (open and edge-case slots). { tags, edgeCase }
  coverageTags        Json?              @map("coverage_tags")
  /// Last automated check results (TASK-KYC section 5) and synthetic-data flags with the author's explanations.
  checks              Json?
  flags               Json?
  rejectReason        TaskRejectReason?  @map("reject_reason")
  /// Content quarantined after a confirmed real-data finding; the output is removed and never enters the dataset.
  quarantinedAt       DateTime?          @map("quarantined_at")
  /// Text embedding of the submitted task for near-duplicate search (pgvector, cosine).
  embedding           Unsupported("vector(768)")?
  lastSavedAt         DateTime?          @map("last_saved_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  submissions       TaskSubmission[]
  reviews           TaskReview[]
  project           Project            @relation(fields: [projectId], references: [id])
  slot              CoverageSlot?      @relation(fields: [slotId], references: [id])
  inputBatch        TaskInputBatch?    @relation(fields: [inputBatchId], references: [id])
  rlReviewRequest   RLReviewRequest?   @relation(fields: [rlReviewRequestId], references: [id])
  assignedTo        Candidate?         @relation(fields: [assignedToId], references: [id])
  projectAssignment ProjectAssignment? @relation(fields: [projectAssignmentId], references: [id])
  similarityChecks  SimilarityCheck[]  @relation("SimilaritySubject")
  approvedRecords   ApprovedTaskRecord[]

  @@index([projectId, status])
  @@index([assignedToId, status])
}

model SimilarityCheck {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String           @map("client_id") @db.Uuid
  taskInstanceId String           @map("task_instance_id") @db.Uuid
  comparedToId   String           @map("compared_to_id") @db.Uuid
  score          Decimal          @db.Decimal(5, 4)
  method         SimilarityMethod
  flagged        Boolean          @default(false)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  taskInstance TaskInstance @relation("SimilaritySubject", fields: [taskInstanceId], references: [id])

  @@index([taskInstanceId])
}

model Invite {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId            String        @map("client_id") @db.Uuid
  projectAssignmentId String        @map("project_assignment_id") @db.Uuid
  tokenHash           String        @unique @map("token_hash")
  channel             InviteChannel
  sentAt              DateTime?     @map("sent_at")
  expiresAt           DateTime      @map("expires_at")
  usedAt              DateTime?     @map("used_at")
  revoked             Boolean       @default(false)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  projectAssignment ProjectAssignment @relation(fields: [projectAssignmentId], references: [id])
}

// ─────────────────── Approved Task Dataset and FLOW 4 (append-only) ───────────────────

/// RL Gym base table. Append-only; one per accepted TaskInstance (plus correction records via supersedesId).
model ApprovedTaskRecord {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Chain order: assigned at insert while the chain lock is held (created_at is transaction start time).
  seq                   BigInt    @unique @default(autoincrement())
  schemaVersion         Int       @map("schema_version")
  createdAt             DateTime  @default(now()) @map("created_at")
  contentHash           String    @map("content_hash")
  prevHash              String?   @map("prev_hash")
  supersedesId          String?   @map("supersedes_id") @db.Uuid
  // Task
  taskInstanceId        String    @map("task_instance_id") @db.Uuid
  taskMode              TaskType  @map("task_mode")
  input                 Json
  output                Json
  activeSeconds         Int       @map("active_seconds")
  submittedAt           DateTime  @map("submitted_at")
  // Diversity
  slotId                String?   @map("slot_id") @db.Uuid
  coverageTags          Json?     @map("coverage_tags")
  isOpenSlot            Boolean   @default(false) @map("is_open_slot")
  nearestDuplicateId    String?   @map("nearest_duplicate_id") @db.Uuid
  nearestDuplicateScore Decimal?  @map("nearest_duplicate_score") @db.Decimal(5, 4)
  authorTaskIndex       Int?      @map("author_task_index")
  // Input provider (annotation)
  inputSource           InputSource? @map("input_source")
  inputBatchId          String?   @map("input_batch_id") @db.Uuid
  uploadedById          String?   @map("uploaded_by_id") @db.Uuid
  apiClientId           String?   @map("api_client_id") @db.Uuid
  // Worker
  candidateId           String    @map("candidate_id") @db.Uuid
  identityRef           String?   @map("identity_ref")
  projectAssignmentId   String?   @map("project_assignment_id") @db.Uuid
  qualificationSnapshot Json?     @map("qualification_snapshot")
  // Reviewer
  reviewerId            String    @map("reviewer_id") @db.Uuid
  reviewDecisionAt      DateTime  @map("review_decision_at")
  reviewNotes           String?   @map("review_notes")
  reworkCount           Int       @default(0) @map("rework_count")
  duplicateDecision     DuplicateDecision? @map("duplicate_decision")
  // Context
  clientId              String    @map("client_id") @db.Uuid
  projectId             String    @map("project_id") @db.Uuid
  templateId            String    @map("template_id") @db.Uuid
  templateVersion       Int       @map("template_version")
  domain                String
  workflow              String
  jdSnapshotId          String?   @map("jd_snapshot_id") @db.Uuid
  // Consent
  workerTermsVersion    String?   @map("worker_terms_version")

  taskInstance TaskInstance        @relation(fields: [taskInstanceId], references: [id])
  supersedes   ApprovedTaskRecord? @relation("Supersedes", fields: [supersedesId], references: [id])
  supersededBy ApprovedTaskRecord[] @relation("Supersedes")

  @@index([createdAt])
  @@index([projectId])
}

model RLReviewRequest {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String                @map("client_id") @db.Uuid
  rlRunId         String                @map("rl_run_id")
  rlTaskId        String                @map("rl_task_id")
  sourceRecordIds String[]              @map("source_record_ids") @db.Uuid
  evalResults     Json                  @map("eval_results")
  /// Inline steps, or { signedUrl } when large.
  trajectories    Json
  rubricId        String?               @map("rubric_id")
  priority        Int                   @default(0)
  dueBy           DateTime?             @map("due_by")
  status          RLReviewRequestStatus @default(RECEIVED)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  task    TaskInstance?
  records RLReviewRecord[]

  @@unique([rlRunId, rlTaskId])
}

/// Append-only reviewer verdict returned to RL Gym; same hash-chain rules as ApprovedTaskRecord.
model RLReviewRecord {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String    @map("client_id") @db.Uuid
  schemaVersion     Int       @map("schema_version")
  createdAt         DateTime  @default(now()) @map("created_at")
  contentHash       String    @map("content_hash")
  prevHash          String?   @map("prev_hash")
  supersedesId      String?   @map("supersedes_id") @db.Uuid
  rlReviewRequestId String    @map("rl_review_request_id") @db.Uuid
  rlRunId           String    @map("rl_run_id")
  rlTaskId          String    @map("rl_task_id")
  sourceRecordIds   String[]  @map("source_record_ids") @db.Uuid
  reviewerId        String    @map("reviewer_id") @db.Uuid
  verdict           RLVerdict
  /// [{ metric, agree, comment }]
  metricVerdicts    Json      @map("metric_verdicts")
  /// [{ text, trajectoryStep?, reasonCode? }]
  comments          Json
  reasonCodes       String[]  @map("reason_codes")
  rubricId          String?   @map("rubric_id")
  reviewStartedAt   DateTime? @map("review_started_at")
  reviewSubmittedAt DateTime  @map("review_submitted_at")
  deliveredAt       DateTime? @map("delivered_at")

  request RLReviewRequest @relation(fields: [rlReviewRequestId], references: [id])

  @@index([createdAt])
}

/// Seeded, Admin-editable FLOW 4 failure reason codes.
model FailureReasonCode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  code      String
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, code])
}

// ───────────────── Platform: audit, outbox, idempotency, webhooks ─────────────────

/// Append-only record of every status change and every PM or Reviewer decision.
model AuditEvent {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId   String    @map("client_id") @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  action     String
  before     Json?
  after      Json?
  requestId  String?   @map("request_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Transactional outbox: written in the same transaction as the state change; the worker publishes it.
model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  name          String
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  availableAt   DateTime  @default(now()) @map("available_at")
  dispatchedAt  DateTime? @map("dispatched_at")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([dispatchedAt, availableAt])
}

/// One row per (event, handler) that completed; makes handlers idempotent under at-least-once delivery.
model EventHandlerReceipt {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  handler     String
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([eventId, handler])
}

/// Stored responses for Idempotency-Key replay on state-changing requests.
model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  actorId        String   @map("actor_id")
  key            String
  method         String
  path           String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([actorId, key])
  @@index([expiresAt])
}

/// Deduplicated inbound provider webhooks (Stripe, job boards, RL Gym).
model WebhookReceipt {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String?   @map("client_id") @db.Uuid
  provider        String
  externalEventId String    @map("external_event_id")
  livemode        Boolean?
  payloadHash     String    @map("payload_hash")
  receivedAt      DateTime  @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([provider, externalEventId])
}

// ─────────────── SME candidate records (docs/FLOW2-SME.md section 11) ───────────────

/// Candidate account. Stable internal id; provider identities hang off it.
model SmeUser {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String         @map("client_id") @db.Uuid
  displayName       String?        @map("display_name")
  contactEmail      String?        @map("contact_email")
  preferredLanguage String?        @map("preferred_language")
  timezone          String?
  accountStatus     AccountStatus  @default(ACTIVE) @map("account_status")
  identityStatus    IdentityStatus @default(NOT_STARTED) @map("identity_status")
  /// 18+ attestation time; no date of birth is stored.
  adultAttestedAt   DateTime?      @map("adult_attested_at")
  /// Set when PII is deleted on request; lineage records keep candidate_id.
  anonymizedAt      DateTime?      @map("anonymized_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  providerIdentities ProviderIdentity[]
  sessions           Session[]
  identityAttempts   IdentityAttempt[]
  alternativeChecks  AlternativeIdentityCheck[]
  candidate          Candidate?
  enrollments        Enrollment[]
  profileVersions    ProfileVersion[]
  evidence           EvidenceArtifact[]
  assignments        SmeAssignment[]
  consents           Consent[]
  conflicts          ConflictDeclaration[]

  @@index([clientId])
}

/// unique(provider, subject). Never merge accounts on email strings.
model ProviderIdentity {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String       @map("client_id") @db.Uuid
  smeUserId   String       @map("sme_user_id") @db.Uuid
  provider    AuthProvider
  subject     String
  emailAtLink String?      @map("email_at_link")
  linkedAt    DateTime     @default(now()) @map("linked_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  smeUser SmeUser @relation(fields: [smeUserId], references: [id])

  @@unique([provider, subject])
}

/// Stripe Identity VerificationSession reference and status summary. No images, ID numbers or DOB.
model IdentityAttempt {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String         @map("client_id") @db.Uuid
  smeUserId         String         @map("sme_user_id") @db.Uuid
  provider          String         @default("stripe")
  providerSessionId String         @unique @map("provider_session_id")
  livemode          Boolean
  status            IdentityStatus
  /// Over-18 result derived in memory from the provider's verified output. The date of birth is never stored.
  adultConfirmed    Boolean?       @map("adult_confirmed")
  checkedAt         DateTime?      @map("checked_at")
  errorCode         String?        @map("error_code")
  lastEventAt       DateTime?      @map("last_event_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  smeUser SmeUser @relation(fields: [smeUserId], references: [id])

  @@index([smeUserId])
}

/// Approved alternative identity process; never labelled "Stripe verified".
model AlternativeIdentityCheck {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  smeUserId  String   @map("sme_user_id") @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  method     String
  outcome    String
  notes      String?
  decidedAt  DateTime @map("decided_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  smeUser SmeUser @relation(fields: [smeUserId], references: [id])
}

/// The project's SME pool. Each project publishes one pool.
model Opportunity {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String            @map("client_id") @db.Uuid
  projectId String            @unique @map("project_id") @db.Uuid
  status    OpportunityStatus @default(DRAFT)
  /// Working copy the owner edits; publishing freezes it into a new OpportunityVersion.
  draftBrief    Json?         @map("draft_brief")
  draftCriteria Json?         @map("draft_criteria")
  /// Owner-edited question policy; when null, publishing generates the default from the brief and criteria.
  draftQuestionPolicy Json?   @map("draft_question_policy")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  project     Project                @relation(fields: [projectId], references: [id])
  versions    OpportunityVersion[]
  enrollments Enrollment[]
  documents   OpportunityDocument[]
}

enum OpportunityDocumentStatus {
  PENDING_REVIEW
  CONFIRMED
  DISCARDED
}

/// An owner-imported JD document. Only the extracted text and a hash are kept; the text is untrusted until an
/// owner reviews and confirms it (FLOW2-SME C03, CF-07).
model OpportunityDocument {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String                    @map("client_id") @db.Uuid
  opportunityId String                    @map("opportunity_id") @db.Uuid
  filename      String
  mimeType      String                    @map("mime_type")
  sizeBytes     Int                       @map("size_bytes")
  sha256        String
  extractedText String                    @map("extracted_text")
  confirmedText String?                   @map("confirmed_text")
  status        OpportunityDocumentStatus @default(PENDING_REVIEW)
  uploadedById  String                    @map("uploaded_by_id") @db.Uuid
  reviewedById  String?                   @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime?                 @map("reviewed_at")
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])

  @@index([opportunityId])
}

model OpportunityVersion {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  opportunityId  String    @map("opportunity_id") @db.Uuid
  version        Int
  brief          Json
  /// Approved, versioned eligibility criteria (never invented by the model).
  criteria       Json
  questionPolicy Json      @map("question_policy")
  scope          Json
  termsRefs      Json      @default("[]") @map("terms_refs")
  ownerId        String    @map("owner_id") @db.Uuid
  publishedAt    DateTime? @map("published_at")
  publishedById  String?   @map("published_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  opportunity Opportunity  @relation(fields: [opportunityId], references: [id])
  enrollments Enrollment[]

  @@unique([opportunityId, version])
}

/// User x pool. One enrollment per candidate per project pool.
model Enrollment {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId             String           @map("client_id") @db.Uuid
  smeUserId            String           @map("sme_user_id") @db.Uuid
  opportunityId        String           @map("opportunity_id") @db.Uuid
  opportunityVersionId String           @map("opportunity_version_id") @db.Uuid
  profileVersionId     String?          @map("profile_version_id") @db.Uuid
  status               EnrollmentStatus @default(DRAFT)
  revision             Int              @default(0)
  submittedAt          DateTime?        @map("submitted_at")
  /// The specific clarification a reviewer asked for (NEEDS_INFORMATION).
  informationRequest   String?          @map("information_request")
  /// Candidate-facing explanation of the latest human decision (never shown before a human decides).
  decisionMessage      String?          @map("decision_message")
  reviewRequestReason  String?          @map("review_request_reason")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  smeUser            SmeUser                 @relation(fields: [smeUserId], references: [id])
  opportunity        Opportunity             @relation(fields: [opportunityId], references: [id])
  opportunityVersion OpportunityVersion      @relation(fields: [opportunityVersionId], references: [id])
  profileVersion     ProfileVersion?         @relation("EnrollmentProfile", fields: [profileVersionId], references: [id])
  conversation       ConversationSession?
  assessments        SuitabilityAssessment[]
  decisions          SelectionDecision[]
  qualificationScopes QualificationScope[]
  onboarding         OnboardingChecklist?
  assignments        SmeAssignment[]
  applications       Application[]
  projectAssignments ProjectAssignment[]

  @@unique([smeUserId, opportunityId])
}

model ConversationSession {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String                    @map("client_id") @db.Uuid
  enrollmentId String                    @unique @map("enrollment_id") @db.Uuid
  status       ProfileConversationStatus @default(NOT_STARTED)
  /// Version for two-tab conflict detection.
  revision     Int                       @default(0)
  nextQuestion Json?                     @map("next_question")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  enrollment Enrollment         @relation(fields: [enrollmentId], references: [id])
  turns      ConversationTurn[]
}

model ConversationTurn {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String    @map("client_id") @db.Uuid
  sessionId       String    @map("session_id") @db.Uuid
  clientMessageId String    @map("client_message_id")
  sequence        Int
  speaker         Speaker
  /// Stored text. For a message flagged as sensitive this is the redacted copy only; the original is never kept.
  content         String
  redacted        Boolean   @default(false)
  sensitiveKinds  String[]  @map("sensitive_kinds")
  questionId      String?   @map("question_id")
  /// Candidate turns: NONE (quick reply), PENDING, DONE, FAILED (model error; retryable), SKIPPED (sensitive).
  extractionStatus String   @default("NONE") @map("extraction_status")
  acknowledgedAt  DateTime? @map("acknowledged_at")
  schemaVersion   String?   @map("schema_version")
  modelVersion    String?   @map("model_version")
  policyVersion   String?   @map("policy_version")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  session ConversationSession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, clientMessageId])
  @@unique([sessionId, sequence])
}

/// Immutable once submitted; amendments create a new version.
model ProfileVersion {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  smeUserId   String    @map("sme_user_id") @db.Uuid
  /// The enrollment this version was built for (each pool keeps its own snapshot; FLOW2 section 2).
  enrollmentId String?  @map("enrollment_id") @db.Uuid
  version     Int
  data        Json
  /// Precision / unknown flags per field.
  flags       Json      @default("{}")
  /// Field -> source turn / evidence ids.
  sourceLinks Json      @default("{}") @map("source_links")
  contentHash String    @map("content_hash")
  submittedAt DateTime? @map("submitted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  smeUser     SmeUser             @relation(fields: [smeUserId], references: [id])
  enrollments Enrollment[]        @relation("EnrollmentProfile")
  episodes    ExperienceEpisode[]
  claims      CredentialClaim[]

  @@unique([smeUserId, version])
}

model ExperienceEpisode {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String            @map("client_id") @db.Uuid
  profileVersionId String            @map("profile_version_id") @db.Uuid
  startMonth       String?           @map("start_month") // YYYY-MM
  endMonth         String?           @map("end_month") // YYYY-MM, null = current
  precision        DatePrecision
  domain           String?
  specialty        String?
  role             String?
  responsibility   String?
  employerScope    String?           @map("employer_scope")
  contributionMode String?           @map("contribution_mode")
  sourceTurnIds    String[]          @map("source_turn_ids")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  profileVersion ProfileVersion @relation(fields: [profileVersionId], references: [id])
}

model CredentialClaim {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String        @map("client_id") @db.Uuid
  profileVersionId String        @map("profile_version_id") @db.Uuid
  claimType        String        @map("claim_type")
  value            Json
  issuer           String?
  scope            String?
  validFrom        DateTime?     @map("valid_from")
  expiresAt        DateTime?     @map("expires_at")
  evidenceLevel    EvidenceLevel @default(SELF_REPORTED) @map("evidence_level")
  method           String?
  checkerId        String?       @map("checker_id") @db.Uuid
  checkedAt        DateTime?     @map("checked_at")
  disputed         Boolean       @default(false)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  profileVersion ProfileVersion     @relation(fields: [profileVersionId], references: [id])
  evidence       EvidenceArtifact[]
}

/// Private storage only; no public access.
model EvidenceArtifact {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String    @map("client_id") @db.Uuid
  smeUserId          String    @map("sme_user_id") @db.Uuid
  storageKey         String    @unique @map("storage_key")
  /// Sanitised display name; the storage key never contains user input.
  filename           String    @default("")
  sha256             String
  mimeType           String    @map("mime_type")
  sizeBytes          Int       @map("size_bytes")
  permissionGranted  Boolean   @default(false) @map("permission_granted")
  redactionStatus    String    @default("NONE") @map("redaction_status")
  scanStatus         String    @default("PENDING") @map("scan_status")
  retentionCategory  String    @map("retention_category")
  deletionRequestedAt DateTime? @map("deletion_requested_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  smeUser SmeUser           @relation(fields: [smeUserId], references: [id])
  claims  CredentialClaim[]
}

/// AI recommendation. Never a decision.
model SuitabilityAssessment {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId             String            @map("client_id") @db.Uuid
  enrollmentId         String            @map("enrollment_id") @db.Uuid
  profileVersionId     String            @map("profile_version_id") @db.Uuid
  opportunityVersionId String            @map("opportunity_version_id") @db.Uuid
  status               SuitabilityStatus @default(NOT_RUN)
  inputHash            String?           @map("input_hash")
  ruleVersion          String?           @map("rule_version")
  modelVersion         String?           @map("model_version")
  /// Per criterion: MET / PARTIALLY_MET / NOT_MET / UNKNOWN, citations, rationale.
  findings             Json?
  limitations          String?
  proposedScope        Json?             @map("proposed_scope")
  errorCode            String?           @map("error_code")
  supersededById       String?           @map("superseded_by_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  enrollment Enrollment          @relation(fields: [enrollmentId], references: [id])
  decisions  SelectionDecision[]

  @@index([enrollmentId])
}

/// Human reviewer decision. Append-only.
model SelectionDecision {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String           @map("client_id") @db.Uuid
  enrollmentId     String           @map("enrollment_id") @db.Uuid
  reviewerId       String           @map("reviewer_id") @db.Uuid
  outcome          SelectionOutcome
  reasons          Json
  profileVersionId String           @map("profile_version_id") @db.Uuid
  assessmentId     String?          @map("assessment_id") @db.Uuid
  criteriaRef      Json             @map("criteria_ref")
  decidedAt        DateTime         @default(now()) @map("decided_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  enrollment          Enrollment             @relation(fields: [enrollmentId], references: [id])
  assessment          SuitabilityAssessment? @relation(fields: [assessmentId], references: [id])
  qualificationScopes QualificationScope[]
}

model QualificationScope {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId            String             @map("client_id") @db.Uuid
  enrollmentId        String             @map("enrollment_id") @db.Uuid
  selectionDecisionId String             @map("selection_decision_id") @db.Uuid
  domain              String
  specialty           String?
  jurisdictions       String[]
  languages           String[]
  contributionRoles   ContributionRole[] @map("contribution_roles")
  conditions          Json               @default("{}")
  expiresAt           DateTime?          @map("expires_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  enrollment        Enrollment        @relation(fields: [enrollmentId], references: [id])
  selectionDecision SelectionDecision @relation(fields: [selectionDecisionId], references: [id])
}

model OnboardingChecklist {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String           @map("client_id") @db.Uuid
  enrollmentId     String           @unique @map("enrollment_id") @db.Uuid
  checklistVersion String           @map("checklist_version")
  items            Json
  status           OnboardingStatus @default(NOT_STARTED)
  blockReason      String?          @map("block_reason")
  completedAt      DateTime?        @map("completed_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  enrollment      Enrollment                  @relation(fields: [enrollmentId], references: [id])
  acknowledgements OnboardingAcknowledgement[]
}

model OnboardingAcknowledgement {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  checklistId    String   @map("checklist_id") @db.Uuid
  itemKey        String   @map("item_key")
  termsHash      String?  @map("terms_hash")
  /// Item answers, e.g. work preferences or the conflict declaration.
  data           Json?
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")
  createdAt      DateTime @default(now()) @map("created_at")

  checklist OnboardingChecklist @relation(fields: [checklistId], references: [id])

  @@unique([checklistId, itemKey])
}

/// Candidate-side assignment: PROPOSED -> ACCEPTED -> HANDED_OFF.
model SmeAssignment {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId              String              @map("client_id") @db.Uuid
  enrollmentId          String              @map("enrollment_id") @db.Uuid
  smeUserId             String              @map("sme_user_id") @db.Uuid
  projectId             String              @map("project_id") @db.Uuid
  requirementsVersion   Int                 @map("requirements_version")
  qualificationSnapshot Json                @map("qualification_snapshot")
  scope                 Json
  capacity              Int?
  deadline              DateTime?
  termsRef              String?             @map("terms_ref")
  status                SmeAssignmentStatus @default(PROPOSED)
  revision              Int                 @default(0)
  declineReason         String?             @map("decline_reason")
  workbenchRef          String?             @map("workbench_ref")
  proposedAt            DateTime            @default(now()) @map("proposed_at")
  /// Proposals not answered by this time expire and free the slot (7 days).
  expiresAt             DateTime?           @map("expires_at")
  respondedAt           DateTime?           @map("responded_at")
  /// Short-lived, single-use handoff to the task workbench (hash only).
  handoffTokenHash      String?             @unique @map("handoff_token_hash")
  handoffExpiresAt      DateTime?           @map("handoff_expires_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  enrollment        Enrollment         @relation(fields: [enrollmentId], references: [id])
  smeUser           SmeUser            @relation(fields: [smeUserId], references: [id])
  projectAssignment ProjectAssignment?

  @@index([smeUserId, status])
}

model Consent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String    @map("client_id") @db.Uuid
  smeUserId String    @map("sme_user_id") @db.Uuid
  purpose   String
  version   String
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  smeUser SmeUser @relation(fields: [smeUserId], references: [id])

  @@index([smeUserId, purpose])
}

/// Employer/customer conflicts: candidate declarations, and reviewer-to-expert conflicts for separation of duties.
model ConflictDeclaration {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId            String    @map("client_id") @db.Uuid
  smeUserId           String    @map("sme_user_id") @db.Uuid
  enrollmentId        String?   @map("enrollment_id") @db.Uuid
  reviewerId          String?   @map("reviewer_id") @db.Uuid
  employerDescription String    @map("employer_description")
  details             String?
  declaredAt          DateTime  @default(now()) @map("declared_at")
  resolvedAt          DateTime? @map("resolved_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  smeUser SmeUser @relation(fields: [smeUserId], references: [id])

  @@index([reviewerId])
}

/// Reviewers assigned to a project's applicant pool (FLOW2: restrict reviewers to assigned pools).
model ProjectReviewer {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  assignedById String   @map("assigned_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

/// Admin-published contributor terms (FLOW2 C07: never invented). Candidates accept a specific version by hash.
model TermsDocument {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  /// contributor | confidentiality_ip | data_use
  key         String
  version     Int
  title       String
  body        String
  sha256      String
  /// Seeded stand-in text for local development; production refuses onboarding while any is in use.
  placeholder Boolean   @default(false)
  publishedById String? @map("published_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([clientId, key, version])
}
