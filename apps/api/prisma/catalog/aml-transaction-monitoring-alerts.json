{
  "schema_version": 1,
  "studio_id": "bank-aml-tm-alerts",
  "catalog": {
    "primary_work": "Triage a queue of synthetic transaction-monitoring alerts: investigate transactions against customer profiles, screen counterparties, escalate or close each alert with a rationale and summarise typologies.",
    "verification_criteria": "Escalation set matches the SME's oracle dispositions (F1 >= 0.99); every alert has exactly the SME's disposition and a rationale of the minimum length; the case summary names the typology of each escalated alert; no tipping-off and no customer exit.",
    "human_gate": "A Reviewer checks the SME's dispositions and the rationale quality before approval; escalations are reviewed by a human investigator.",
    "skills": [
      "AML",
      "Transaction monitoring",
      "Financial crime typologies",
      "Investigations"
    ],
    "default_jd_id": null,
    "task_modes": [
      "AUTHORING"
    ],
    "coverage_dimensions": {
      "dimensions": [
        {
          "key": "typology",
          "label": "Typology",
          "values": [
            "structuring",
            "rapid movement",
            "watchlist",
            "false positive"
          ]
        },
        {
          "key": "segment",
          "label": "Customer segment",
          "values": [
            "retail",
            "small business"
          ]
        }
      ],
      "cells": []
    },
    "edge_case_catalog": [
      {
        "name": "Sanctions near-match",
        "quota": 1,
        "required": true
      },
      {
        "name": "Documented one-off event",
        "quota": 1,
        "required": true
      }
    ],
    "default_distinct_target": 50,
    "default_max_per_expert": 4
  },
  "template_meta": {
    "template_id": "bank-aml-tm-alerts",
    "registry_source": "domain_templates.json",
    "label": "AML transaction-monitoring alerts",
    "domain_category": "Banking",
    "version": 1,
    "tpt_minutes": 40,
    "tpt_label": "40m (6 Alerts)",
    "modes": [
      "HERMETIC_SQL"
    ]
  },
  "harbor_contract": {
    "atif_v1_2": true,
    "network_internal": true,
    "require_solve_sh": true,
    "zero_baseline_gate": true
  },
  "domain_meta": {
    "title": "AML transaction-monitoring alerts",
    "persona_label": "AML Investigator",
    "objective": "Escalate the alerts that need a referral and close the false positives, with reasons.",
    "horizon": {
      "type": "episodic_loop",
      "max_turns": 6,
      "cadence_unit": "Alerts"
    }
  },
