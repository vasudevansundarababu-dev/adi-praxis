# Copy to .env for local dev. Never commit real secrets.

# --- Database (docker-compose defaults) ---
DATABASE_URL=postgresql://praxis:praxis@localhost:5442/praxis
TEST_DATABASE_URL=postgresql://praxis:praxis@localhost:5442/praxis_test

# --- Redis ---
REDIS_URL=redis://localhost:6389

# --- API ---
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Allowed browser origins for the console and candidate apps (comma separated)
CORS_ORIGINS=http://localhost:3100,http://localhost:3101
# Internal-user session lifetime in hours
SESSION_TTL_HOURS=12
# Set to true behind HTTPS so session cookies are Secure
COOKIE_SECURE=false

# --- Seed: first Admin account (local dev only) ---
SEED_ADMIN_EMAIL=admin@praxis.local
SEED_ADMIN_PASSWORD=change-me-locally-please
SEED_CLIENT_NAME=ADI-Labs
# Template catalog source (defaults to docs/Taskflow.xlsx)
TASKFLOW_PATH=

# --- Email (Mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1035
EMAIL_FROM="ADI Praxis <no-reply@praxis.local>"

# --- Storage (fake-gcs-server locally) ---
GCS_EMULATOR_HOST=http://localhost:4443
GCS_PROJECT_ID=praxis-local

# --- External services (mocked in local dev and tests; used from M4 on) ---
GOOGLE_OAUTH_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
