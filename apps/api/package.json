{
  "name": "@praxis/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "openapi": "tsx scripts/export-openapi.ts",
    "db:seed:candidates": "tsx --env-file-if-exists=../../.env prisma/seed-candidates.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@anthropic-ai/vertex-sdk": "0.19.11",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "9.4.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "5.2.6",
    "@google-cloud/storage": "7.22.0",
    "@node-rs/argon2": "2.2.1",
    "@praxis/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "fastify-plugin": "5.1.0",
    "fastify-type-provider-zod": "4.0.2",
    "google-auth-library": "9.15.1",
    "ioredis": "5.11.1",
    "mammoth": "1.13.0",
    "stripe": "18.5.0",
    "unpdf": "1.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "jszip": "3.10.1",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
