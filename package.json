{
  "name": "adi-praxis",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @praxis/api db:migrate",
    "db:seed": "pnpm --filter @praxis/api db:seed"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.4"
  }
}
