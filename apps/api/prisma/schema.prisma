  @@unique([clientId, key, version])
}

// ───────────────────────── M9 task drafting (docs/TASK-DRAFTING.md) ─────────────────────────

enum TaskSourceKind {
  DOCUMENT
  TRANSCRIPT
}

/// A document or interview transcript an author uploaded to draft from. Private to the task: the author, the
/// project's Reviewers and Admins can open it; it never enters the Approved Task Dataset (only its SHA-256 does).
model TaskSource {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String         @map("client_id") @db.Uuid
  taskInstanceId String         @map("task_instance_id") @db.Uuid
  kind           TaskSourceKind
  /// Sanitised display name; the storage key never contains user input.
  fileName       String         @map("file_name")
  contentType    String         @map("content_type")
  sizeBytes      Int            @map("size_bytes")
  sha256         String
  storageKey     String         @unique @map("storage_key")
  textChars      Int            @map("text_chars")
  /// Likely real identifiers found in the extracted text: [{ kind, excerpt, line }].
  scanFlags      Json           @default("[]") @map("scan_flags")
  scanStatus     String         @default("PENDING") @map("scan_status")
  uploadedById   String         @map("uploaded_by_id") @db.Uuid
  deletedAt      DateTime?      @map("deleted_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  task TaskInstance @relation(fields: [taskInstanceId], references: [id])

  @@index([taskInstanceId])
}

/// The in-workbench AI interview: one row per question asked and per answer given.
model TaskInterviewTurn {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  taskInstanceId  String   @map("task_instance_id") @db.Uuid
  seq             Int
  speaker         String
  questionId      String   @map("question_id")
  content         String
  /// Sensitive content was removed before storing (as in the profile chat).
  redacted        Boolean  @default(false)
  clientMessageId String?  @map("client_message_id")
  createdAt       DateTime @default(now()) @map("created_at")

  task TaskInstance @relation(fields: [taskInstanceId], references: [id])

  @@unique([taskInstanceId, seq])
  @@unique([taskInstanceId, clientMessageId])
}

enum TaskDraftRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// One request to draft all of W01–W05, or one section, from the task's sources and interview.
model TaskDraftRun {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String             @map("client_id") @db.Uuid
  taskInstanceId String             @map("task_instance_id") @db.Uuid
  /// W01–W05, or null for all sections.
  section        String?
  instruction    String?
  status         TaskDraftRunStatus @default(QUEUED)
  sourceIds      String[]           @map("source_ids")
  interviewTurns Int                @default(0) @map("interview_turns")
  model          String?
  promptVersion  String             @map("prompt_version")
  /// Sections actually written, and validation problems that were repaired or caused failure.
  sections       String[]           @default([])
  problems       Json               @default("[]")
  /// What the drafter assumed or could not fill, shown to the author.
  notes          String?
  error          String?
  requestedById  String             @map("requested_by_id") @db.Uuid
  startedAt      DateTime?          @map("started_at")
  finishedAt     DateTime?          @map("finished_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  task TaskInstance @relation(fields: [taskInstanceId], references: [id])

  @@index([taskInstanceId, createdAt])
}

// ───────────────────────── M10a SME supply: partners and requisitions (docs/SME-SUPPLY.md) ─────────────────────────

enum SmeTier {
  EXPERT
  REVIEWER_SME
  ANNOTATOR
}

enum PartnerStatus {
  ACTIVE
  SUSPENDED
}

enum PartnerEnvironment {
  SANDBOX
  LIVE
}

/// A staffing partner that supplies candidates (section 5). Onboarded by an Admin.
model Partner {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId             String        @map("client_id") @db.Uuid
  name                 String
  status               PartnerStatus @default(ACTIVE)
  /// e.g. PENDING, VERIFIED (recorded by the Admin after checking the business).
  businessVerification String        @default("PENDING") @map("business_verification")
  contacts             Json          @default("[]")
  allowedDomains       String[]      @default([]) @map("allowed_domains")
  allowedTiers         SmeTier[]     @default([]) @map("allowed_tiers")
  feeTermsVersion      String?       @map("fee_terms_version")
  /// M10c: fee per certified candidate (currency below); null = no fee agreed yet.
  certifiedFee         Decimal?      @map("certified_fee") @db.Decimal(12, 2)
  feeCurrency          String        @default("USD") @map("fee_currency")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  users       PartnerUser[]
  clients     PartnerClient[]
  webhooks    PartnerWebhook[]
  submissions PartnerSubmission[]

  @@unique([clientId, name])
}

/// A person at a partner who signs in to the partner portal (email + password, argon2id).
model PartnerUser {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String     @map("client_id") @db.Uuid
  partnerId          String     @map("partner_id") @db.Uuid
  email              String     @unique
  name               String
  passwordHash       String     @map("password_hash")
  /// Set when an Admin issues a temporary password; the partner user must choose their own first.
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  status             UserStatus @default(ACTIVE)
  lastLoginAt        DateTime?  @map("last_login_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  partner  Partner   @relation(fields: [partnerId], references: [id])
  sessions Session[]
}

/// OAuth2 client credentials for the Partner API (one or more per partner, sandbox or live). Secret stored as a hash.
model PartnerClient {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String             @map("client_id") @db.Uuid
  partnerId   String             @map("partner_id") @db.Uuid
  /// Public client id, e.g. pc_live_…
  publicId    String             @unique @map("public_id")
  secretHash  String             @map("secret_hash")
  scopes      String[]
  environment PartnerEnvironment
  rotatedAt   DateTime?          @map("rotated_at")
  revokedAt   DateTime?          @map("revoked_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  partner Partner              @relation(fields: [partnerId], references: [id])
  tokens  PartnerAccessToken[]
}

/// Short-lived bearer tokens issued by POST /partner/v1/oauth/token. Only the SHA-256 is stored.
model PartnerAccessToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  clientRef String   @map("client_ref") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  scopes    String[]
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  client PartnerClient @relation(fields: [clientRef], references: [id])

  @@index([expiresAt])
}

/// A partner's webhook endpoint. The signing secret is stored encrypted (it must be available to sign).
model PartnerWebhook {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String             @map("client_id") @db.Uuid
  partnerId   String             @map("partner_id") @db.Uuid
  url         String
  secretEnc   String             @map("secret_enc")
  events      String[]
  environment PartnerEnvironment
  status      String             @default("ACTIVE")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  partner    Partner                  @relation(fields: [partnerId], references: [id])
  deliveries PartnerWebhookDelivery[]
}

/// One event to one webhook, retried with backoff; replays create a new delivery.
model PartnerWebhookDelivery {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  webhookId      String    @map("webhook_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  eventType      String    @map("event_type")
  payload        Json
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  lastStatusCode Int?      @map("last_status_code")
  lastError      String?   @map("last_error")
  deliveredAt    DateTime? @map("delivered_at")
  replayOfId     String?   @map("replay_of_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  webhook PartnerWebhook @relation(fields: [webhookId], references: [id])

  @@index([status, nextAttemptAt])
}

enum RequisitionState {
  DRAFT
  OPEN
  PAUSED
  FILLED
  CLOSED
}

/// A request for SMEs created from a project (section 4).
model Requisition {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId            String           @map("client_id") @db.Uuid
  projectId           String           @map("project_id") @db.Uuid
  title               String
  /// Partner-facing summary (never items, gold answers or scoring rules).
  summary             String           @default("")
  domain              String
  tier                SmeTier
  headcount           Int
  startDate           DateTime?        @map("start_date") @db.Date
  durationWeeks       Int?             @map("duration_weeks")
  hoursPerWeek        Int?             @map("hours_per_week")
  location            String?
  jurisdictions       String[]         @default([])
  languages           String[]         @default([])
  /// { minYears, qualifications[], licenceRequired, notes }
  minimumRequirements Json             @default("{}") @map("minimum_requirements")
  guidelinesPackageId String?          @map("guidelines_package_id") @db.Uuid
  guidelinesVersion   Int?             @map("guidelines_version")
  rateCardId          String?          @map("rate_card_id") @db.Uuid
  /// M10c: DIRECT = Praxis pays the SME (payee set-up required); VIA_PARTNER = the partner pays its people.
  payRoute            PayRoute         @default(DIRECT) @map("pay_route")
  allowedPartnerIds   String[]         @default([]) @map("allowed_partner_ids")
  directChannel       Boolean          @default(false) @map("direct_channel")
  submissionDeadline  DateTime?        @map("submission_deadline")
  maxPerPartner       Int?             @map("max_per_partner")
  state               RequisitionState @default(DRAFT)
  createdById         String           @map("created_by_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  project     Project             @relation(fields: [projectId], references: [id])
  submissions PartnerSubmission[]

  @@index([projectId])
  @@index([state])
}

/// One person across partners and channels, matched on normalised email and phone, then on verified identity.
model SupplyCandidate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  emailNorm String   @map("email_norm")
  phoneNorm String?  @map("phone_norm")
  name      String
  country   String?
  /// Linked when the candidate accepts an invite and signs in (FLOW 2 SME user).
  smeUserId String?  @unique @map("sme_user_id") @db.Uuid
  sandbox   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  submissions PartnerSubmission[]

  @@unique([clientId, sandbox, emailNorm])
  @@index([clientId, sandbox, phoneNorm])
}

enum SubmissionState {
  RECEIVED
  DUPLICATE
  INVITED
  EXPIRED
  WITHDRAWN
}

enum ScreenState {
  NOT_RUN
  MEETS
  DOES_NOT_MEET_RECOMMENDED
  UNCLEAR
  CONFIRMED_NOT_MET
}

enum SubmissionChannel {
  PARTNER_API
  PARTNER_PORTAL
  DIRECT
}

/// A candidate put forward for a requisition by a partner (or directly). The first valid submission owns the candidate
/// for 12 months; duplicates are recorded with a reason that never names the owner.
model PartnerSubmission {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String            @map("client_id") @db.Uuid
  partnerId        String?           @map("partner_id") @db.Uuid
  requisitionId    String            @map("requisition_id") @db.Uuid
  candidateId      String            @map("candidate_id") @db.Uuid
  channel          SubmissionChannel
  partnerRef       String?           @map("partner_ref")
  state            SubmissionState   @default(RECEIVED)
  screen           ScreenState       @default(NOT_RUN)
  screenReasons    Json              @default("[]") @map("screen_reasons")
  screenDecidedBy  String?           @map("screen_decided_by") @db.Uuid
  duplicateReason  String?           @map("duplicate_reason")
  ownerUntil       DateTime?         @map("owner_until")
  /// Submitted details: phone, experience summary, years, employment history, qualifications, attestation, consent.
  details          Json              @default("{}")
  cvStorageKey     String?           @map("cv_storage_key")
  inviteTokenHash  String?           @unique @map("invite_token_hash")
  invitedAt        DateTime?         @map("invited_at")
  inviteExpiresAt  DateTime?         @map("invite_expires_at")
  reminderSentAt   DateTime?         @map("reminder_sent_at")
  inviteAcceptedAt DateTime?         @map("invite_accepted_at")
  enrollmentId     String?           @map("enrollment_id") @db.Uuid
  endedAt          DateTime?         @map("ended_at")
  sandbox          Boolean           @default(false)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  partner     Partner?              @relation(fields: [partnerId], references: [id])
  requisition Requisition           @relation(fields: [requisitionId], references: [id])
  candidate   SupplyCandidate       @relation(fields: [candidateId], references: [id])
  history     CandidateStateEvent[]

  @@unique([partnerId, partnerRef])
  @@index([candidateId])
  @@index([requisitionId, state])
}

/// History of every state change per dimension (section 6), as shown to the partner. Append-only.
model CandidateStateEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  dimension    String
  fromState    String?  @map("from_state")
  toState      String   @map("to_state")
  reason       String?
  at           DateTime @default(now())

  submission PartnerSubmission @relation(fields: [submissionId], references: [id])

  @@index([submissionId, at])
}

// ───────────────────────── M10b Guidelines → courses and certifications (docs/SME-SUPPLY.md section 7) ─────────────────────────

/// A guidelines package for a domain and task family; versions are uploaded by an Admin.
model GuidelinesPackage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  domain     String
  taskFamily String   @map("task_family")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")

  versions GuidelinesVersion[]

  @@unique([clientId, domain, taskFamily])
}

/// One uploaded version: the source file (private), its cited sections, and what has been generated and published.
model GuidelinesVersion {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  packageId      String    @map("package_id") @db.Uuid
  version        Int
  /// A major version needs an update module before an SME's next task; a minor version only notifies.
  major          Boolean   @default(true)
  fileName       String    @map("file_name")
  storageKey     String    @map("storage_key")
  sha256         String
  /// [{ anchor, heading, text }] — every generated artifact cites these anchors.
  sections       Json      @default("[]")
  status         String    @default("GENERATING")
  publishedTiers SmeTier[] @default([]) @map("published_tiers")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  package    GuidelinesPackage        @relation(fields: [packageId], references: [id])
  runs       GenerationRun[]
  knowledge  KnowledgeItem[]
  courses    Course[]
  blueprints CertificationBlueprint[]

  @@unique([packageId, version])
}

/// One generation pipeline run (or one regeneration of a stage/artifact), with model, prompts and cost.
model GenerationRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  versionId      String    @map("version_id") @db.Uuid
  /// FULL, or a single stage: KNOWLEDGE, COURSE, BLUEPRINT, FAMILIES, SAMPLE
  scope          String    @default("FULL")
  target         Json      @default("{}")
  stage          String    @default("QUEUED")
  status         String    @default("QUEUED")
  model          String?
  promptVersions Json      @default("{}") @map("prompt_versions")
  cost           Json      @default("{}")
  error          String?
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  finishedAt     DateTime? @map("finished_at")

  version GuidelinesVersion @relation(fields: [versionId], references: [id])
}

/// Rules, definitions, steps, thresholds, edge cases and failure modes extracted from the guidelines, each cited.
model KnowledgeItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  versionId String   @map("version_id") @db.Uuid
  kind      String
  text      String
  citation  String
  critical  Boolean  @default(false)
  status    String   @default("DRAFT")
  model     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  version GuidelinesVersion @relation(fields: [versionId], references: [id])

  @@index([versionId])
}

/// One course per tier per guidelines version.
model Course {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  versionId     String    @map("version_id") @db.Uuid
  tier          SmeTier
  title         String
  status        String    @default("DRAFT")
  model         String?
  promptVersion String?   @map("prompt_version")
  approvedById  String?   @map("approved_by_id") @db.Uuid
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  version GuidelinesVersion @relation(fields: [versionId], references: [id])
  modules CourseModule[]

  @@unique([versionId, tier])
}

model CourseModule {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  position     Int
  title        String
  explanation  String
  goodExamples Json     @default("[]") @map("good_examples")
  badExamples  Json     @default("[]") @map("bad_examples")
  /// [{ question, options[], answerIndex, feedback, citation }]
  quiz         Json     @default("[]")
  practice     Json     @default("[]")
  citations    String[] @default([])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id])

  @@unique([courseId, position])
}

/// One certification blueprint per tier per guidelines version (section 7.2 defaults, editable before approval).
model CertificationBlueprint {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String    @map("client_id") @db.Uuid
  versionId        String    @map("version_id") @db.Uuid
  tier             SmeTier
  /// [{ key, name, weight, citations[] }]; weights sum to 100
  competencies     Json      @default("[]")
  itemCount        Int       @map("item_count")
  authoringTask    Boolean   @default(false) @map("authoring_task")
  timeLimitMinutes Int       @map("time_limit_minutes")
  /// { overallPct, plantedErrorsPct?, noCriticalMiss, writtenPassScore?, confirmationsRequired? }
  passRules        Json      @map("pass_rules")
  status           String    @default("DRAFT")
  model            String?
  approvedById     String?   @map("approved_by_id") @db.Uuid
  approvedAt       DateTime? @map("approved_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  version  GuidelinesVersion @relation(fields: [versionId], references: [id])
  families ItemFamily[]
  forms    TestForm[]

  @@unique([versionId, tier])
}

/// A reusable question template. The correct answer is derived from the variables by `answerRule`, never by a model.
model ItemFamily {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId            String   @map("client_id") @db.Uuid
  blueprintId         String   @map("blueprint_id") @db.Uuid
  competency          String
  /// Difficulty band on a 1–5 scale: [min, max]
  difficultyMin       Int      @map("difficulty_min")
  difficultyMax       Int      @map("difficulty_max")
  cognitiveLevel      String   @map("cognitive_level")
  itemType            String   @map("item_type")
  stemPattern         String   @map("stem_pattern")
  variableSchema      Json     @map("variable_schema")
  answerRule          Json     @map("answer_rule")
  options             String[] @default([])
  distractorRationale String   @default("") @map("distractor_rationale")
  citation            String
  /// Missing this item fails the test (critical rule).
  critical            Boolean  @default(false)
  status              String   @default("DRAFT")
  /// Approvals so far: [{ userId, role, at }]
  approvals           Json     @default("[]")
  /// { served, correct, validationFailures, consecutiveFailures }
  stats               Json     @default("{}")
  model               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  blueprint CertificationBlueprint @relation(fields: [blueprintId], references: [id])
  instances ItemInstance[]

  @@index([blueprintId, status])
}

/// One generated question. Served to one candidate only; the key is encrypted.
model ItemInstance {
  id          String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String                      @map("client_id") @db.Uuid
  familyId    String                      @map("family_id") @db.Uuid
  variables   Json
  /// SHA-256 of the family and its canonical variables: no two instances of a family share it.
  fingerprint String
  stem        String
  /// Presentation: options, trajectory steps, etc.
  content     Json                        @default("{}")
  keyEnc      String                      @map("key_enc")
  validation  Json                        @default("{}")
  embedding   Unsupported("vector(768)")?
  /// SAMPLE (for Admin review, never served), VALID, DISCARDED
  status      String                      @default("VALID")
  servedTo    String?                     @map("served_to") @db.Uuid
  servedAt    DateTime?                   @map("served_at")
  createdAt   DateTime                    @default(now()) @map("created_at")

  family ItemFamily @relation(fields: [familyId], references: [id])

  @@unique([familyId, fingerprint])
  @@index([familyId, status])
}

/// A pre-assembled, pre-validated test form. Buffered, used once.
model TestForm {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  blueprintId String    @map("blueprint_id") @db.Uuid
  itemIds     String[]  @map("item_ids")
  status      String    @default("BUFFERED")
  usedBy      String?   @unique @map("used_by") @db.Uuid
  assembledAt DateTime  @default(now()) @map("assembled_at")
  usedAt      DateTime? @map("used_at")

  blueprint CertificationBlueprint @relation(fields: [blueprintId], references: [id])

  @@index([blueprintId, status])
}

enum CertificationState {
  NOT_STARTED
  IN_TRAINING
  TEST_READY
  IN_TEST
  PASSED
  RETAKE_AVAILABLE
  REVIEW_REQUIRED
  NOT_CERTIFIED
  EXPIRED
}

/// An SME's certification for one domain, tier and guidelines version (section 6).
model Certification {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String             @map("client_id") @db.Uuid
  smeUserId         String             @map("sme_user_id") @db.Uuid
  domain            String
  tier              SmeTier
  versionId         String             @map("version_id") @db.Uuid
  requisitionId     String?            @map("requisition_id") @db.Uuid
  state             CertificationState @default(NOT_STARTED)
  /// Module ids completed in order.
  completedModules  String[]           @default([]) @map("completed_modules")
  attemptsUsed      Int                @default(0) @map("attempts_used")
  retakeAvailableAt DateTime?          @map("retake_available_at")
  reviewReason      String?            @map("review_reason")
  licenceRequired   Boolean            @default(false) @map("licence_required")
  /// { number, issuingBody, fileName, storageKey, submittedAt }
  licence           Json?
  licenceStatus     String?            @map("licence_status")
  licenceDecidedBy  String?            @map("licence_decided_by") @db.Uuid
  issuedAt          DateTime?          @map("issued_at")
  expiresAt         DateTime?          @map("expires_at")
  decidedBy         String?            @map("decided_by") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  attempts TestAttempt[]

  @@unique([smeUserId, domain, tier, versionId])
}

/// One sitting of a certification test.
model TestAttempt {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String    @map("client_id") @db.Uuid
  certificationId String    @map("certification_id") @db.Uuid
  smeUserId       String    @map("sme_user_id") @db.Uuid
  attemptNo       Int       @map("attempt_no")
  formId          String    @map("form_id") @db.Uuid
  itemIds         String[]  @map("item_ids")
  /// IN_PROGRESS, NEEDS_REVIEW, PASSED, FAILED
  status          String    @default("IN_PROGRESS")
  /// Provider reference and result of the selfie re-check (never an image or ID number).
  identityCheck   Json      @map("identity_check")
  startedAt       DateTime  @default(now()) @map("started_at")
  deadlineAt      DateTime  @map("deadline_at")
  submittedAt     DateTime? @map("submitted_at")
  answers         Json      @default("{}")
  integrityEvents Json      @default("[]") @map("integrity_events")
  /// Per item: { correct?, score?, recommendation?, confirmations[] }
  grading         Json      @default("{}")
  score           Decimal?  @db.Decimal(5, 2)
  sectionScores   Json      @default("{}") @map("section_scores")
  result          String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  certification Certification @relation(fields: [certificationId], references: [id])

  @@unique([certificationId, attemptNo])
}

enum SmeStandingState {
  PROBATION
  ACTIVE
  RETRAINING
  SUSPENDED
  OFFBOARDED
}

/// SME standing per domain and tier; every change is a new row (history kept), approved by a person.
model SmeStanding {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String           @map("client_id") @db.Uuid
  smeUserId    String           @map("sme_user_id") @db.Uuid
  domain       String
  tier         SmeTier
  standing     SmeStandingState
  metrics      Json             @default("{}")
  reason       String?
  approvedById String?          @map("approved_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([smeUserId, domain, createdAt])
}

// ───────────────────────── M10c payments (docs/SME-SUPPLY.md section 8) ─────────────────────────

enum PayRoute {
  DIRECT
  VIA_PARTNER
}

/// A rate card version: never edited; a change is a new version of the same name.
model RateCard {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  name        String
  version     Int
  /// USD or INR (owner decision, 28 Sep 2026).
  currency    String
  /// { AUTHORING: "40.00", ANNOTATION: "8.00", RL_REVIEW: "20.00" } per task type.
  perTask     Json     @map("per_task")
  hourlyRate  Decimal? @map("hourly_rate") @db.Decimal(12, 2)
  weeklyCap   Decimal? @map("weekly_cap") @db.Decimal(12, 2)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([clientId, name, version])
}

enum EarningKind {
  TASK
  RL_REVIEW
  HOURS
  REVERSAL
}

/// Ledger of what an SME earned. Append-only in the database; a correction is a reversing entry.
model EarningEntry {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String      @map("client_id") @db.Uuid
  smeUserId       String      @map("sme_user_id") @db.Uuid
  amount          Decimal     @db.Decimal(12, 2)
  currency        String
  kind            EarningKind
  sourceType      String      @map("source_type")
  sourceId        String      @map("source_id")
  requisitionId   String?     @map("requisition_id") @db.Uuid
  rateCardId      String?     @map("rate_card_id") @db.Uuid
  rateCardVersion Int?        @map("rate_card_version")
  /// The entry this one reverses (no foreign key: append-only tables are never referenced).
  reversesId      String?     @unique @map("reverses_id") @db.Uuid
  reason          String?
  earnedAt        DateTime    @default(now()) @map("earned_at")
  createdById     String?     @map("created_by_id")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@unique([sourceType, sourceId, kind])
  @@index([smeUserId, earnedAt])
}

enum PayeeStatus {
  NOT_REQUIRED
  NOT_STARTED
  PENDING
  READY
  BLOCKED
}

/// The SME's account at the payout provider. Status only: no bank or tax data is stored in Praxis.
model Payee {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String      @map("client_id") @db.Uuid
  smeUserId      String      @unique @map("sme_user_id") @db.Uuid
  provider       String
  payeeRef       String?     @map("payee_ref")
  status         PayeeStatus @default(NOT_STARTED)
  /// Currency the provider pays out in (e.g. INR for India); set from the provider.
  payoutCurrency String?     @map("payout_currency")
  statusReason   String?     @map("status_reason")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@unique([provider, payeeRef])
}

/// A manual hold on an SME's payouts (dispute, fraud flag). Released by a person; history kept by the audit log.
model PayHold {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  smeUserId   String    @map("sme_user_id") @db.Uuid
  kind        String
  reason      String
  createdById String    @map("created_by_id") @db.Uuid
  releasedAt  DateTime? @map("released_at")
  releasedBy  String?   @map("released_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([smeUserId, releasedAt])
}

enum PayRunStatus {
  DRAFT
  CONFIRMED
  APPROVED
  SUBMITTED
  COMPLETED
  CANCELLED
}

model PayRun {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String       @map("client_id") @db.Uuid
  /// Monday 00:00 UTC to the next Monday (exclusive).
  periodStart      DateTime     @map("period_start")
  periodEnd        DateTime     @map("period_end")
  status           PayRunStatus @default(DRAFT)
  confirmedBy      String?      @map("confirmed_by") @db.Uuid
  confirmedAt      DateTime?    @map("confirmed_at")
  /// [{ userId, at, singleApprover }]
  approvals        Json         @default("[]")
  providerBatchRef String?      @map("provider_batch_ref")
  /// Totals per currency, and what was held or carried forward (reported with the run).
  totals           Json         @default("{}")
  report           Json         @default("{}")
  createdById      String?      @map("created_by_id")
  submittedAt      DateTime?    @map("submitted_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  items PayoutItem[]

  @@unique([clientId, periodStart])
}

enum PayoutItemStatus {
  PENDING
  HELD
  SUBMITTED
  PAID
  FAILED
  RETURNED
}

model PayoutItem {
