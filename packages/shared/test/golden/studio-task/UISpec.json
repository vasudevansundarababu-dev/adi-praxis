{
  "authored_content": {
    "instruction_md": "Plan the launch week by week.\n\nWrite `intent.csv` and `plan.csv` to `/workspace/outputs/`.",
    "mcp_mock_seed_rows": [
      {
        "cpc_usd": 1.4,
        "keyword": "quiet phone deal",
        "monthly_volume": 1200
      },
      {
        "cpc_usd": 0.9,
        "keyword": "best anc phone review",
        "monthly_volume": 900
      }
    ],
    "solve_sh": "#!/usr/bin/env bash\nset -euo pipefail\necho solved\n"
  },
  "catalog": {
    "coverage_dimensions": {
      "cells": [],
      "dimensions": []
    },
    "default_distinct_target": 50,
    "default_jd_id": null,
    "default_max_per_expert": 4,
    "edge_case_catalog": [],
    "human_gate": "A Reviewer checks the oracle table.",
    "primary_work": "Plan a 4-week synthetic launch budget.",
    "skills": [
      "Performance marketing"
    ],
    "task_modes": [
      "AUTHORING"
    ],
    "verification_criteria": "Spend stays under the CAC ceiling; keyword intents match the oracle table."
  },
  "custom_fields_by_stage": {
    "stage_1": [
      {
        "default_value": "en-GB",
        "field_id": "locale",
        "inject_into": [
          "instruction.md",
          "task.json"
        ],
        "input_type": "single_select",
        "label": "Launch locale",
        "options": [
          "en-GB",
          "de-DE"
        ],
        "verifier_assertion": ""
      },
      {
        "default_value": "Quietline",
        "field_id": "brand_name",
        "inject_into": [
          "instruction.md"
        ],
        "input_type": "text_input",
        "label": "Brand name",
        "options": [],
        "verifier_assertion": ""
      }
    ],
    "stage_2": [
      {
        "default_value": [
          "search"
        ],
        "field_id": "channels",
        "inject_into": [
          "task.json",
          "mcp_mock.py"
        ],
        "input_type": "multi_select",
        "label": "Channels",
        "options": [
          "search",
          "social",
          "video"
        ],
        "verifier_assertion": ""
      }
    ],
    "stage_3": [
      {
        "default_value": 42,
        "field_id": "target_cac_ceiling",
        "inject_into": [
          "instruction.md",
          "eval/test_verifiers.py"
        ],
        "input_type": "currency_slider",
        "label": "Target CAC ceiling",
        "max": 100,
        "min": 10,
        "options": [],
        "verifier_assertion": "all(float(r.get('cac_usd', 0)) <= value for r in env_state['outputs'].get('plan.csv') or [{'cac_usd': 999}])"
      }
    ],
    "stage_4": [
      {
        "default_value": true,
        "field_id": "strict_mode",
        "inject_into": [
          "mcp_mock.py"
        ],
        "input_type": "boolean_toggle",
        "label": "Strict brand safety",
        "options": [],
        "verifier_assertion": ""
      }
    ],
    "stage_5": [
      {
        "default_value": 4,
        "field_id": "min_weeks",
        "inject_into": [
          "eval/test_verifiers.py"
        ],
        "input_type": "number_input",
        "label": "Minimum weeks",
        "max": 12,
        "min": 1,
        "options": [],
        "verifier_assertion": "len(env_state['calls']) >= value"
      }
    ]
  },
  "domain_meta": {
    "horizon": {
      "cadence_unit": "week",
      "max_turns": 4,
      "type": "episodic_loop"
    },
    "objective": "Allocate weekly spend and label keyword intent.",
    "persona_label": "Growth Marketing Lead",
    "title": "Golden fixture launch"
  },
  "harbor_contract": {
    "atif_v1_2": true,
    "network_internal": true,
    "require_solve_sh": true,
    "zero_baseline_gate": true
  },
  "schema_version": 1,
  "step_2_data_panels": {
    "oracle_annotator": {
      "columns": [
        "keyword",
        "intent"
      ],
      "dataset_name": "keyword_intent",
      "sme_tag_options": [
        "BUY",
        "RESEARCH",
        "IGNORE"
      ],
      "target_path": "/eval/ground_truth/keyword_intent.csv",
      "template_preview_rows": [
        [
          "quiet phone deal",
          "BUY"
        ],
        [
          "best anc phone review",
          "RESEARCH"
        ],
        [
          "phone case free",
          "IGNORE"
        ]
      ]
    },
    "public_dropzones": [
      {
        "description": "One query per row.",
        "format": "csv",
        "id": "queries",
        "label": "Search queries",
        "target_path": "/workspace/inputs/queries.csv"
      },
      {
        "description": "",
        "format": "md",
        "id": "brief",
        "label": "Launch brief",
        "target_path": "/workspace/inputs/brief.md"
      }
    ]
  },
  "step_3_mcp_simulators": {
    "tools": [
      {
        "description": "Monthly volume for a keyword.",
        "parameters": [
          {
            "description": "",
            "name": "keyword",
            "type": "string"
          }
        ],
        "tool_id": "lookup_keyword"
      },
      {
        "description": "Commit spend for one week.",
        "parameters": [
          {
            "description": "",
            "name": "week",
            "type": "number"
          },
          {
            "description": "",
            "name": "spend_usd",
            "type": "number"
          }
        ],
        "tool_id": "set_week_budget"
      }
    ],
    "widgets": [
      {
        "archetype": "diminishing_returns_curve_slider",
        "default": 12000,
        "formula": "CTR(s) = CTR_base * (s / (s + K_half))",
        "key": "k_half",
        "label": "Saturation (K_half)",
        "max": 50000,
        "min": 1000,
        "step": 500
      },
      {
        "archetype": "fuzzy_match_threshold_slider",
        "default": 0.85,
        "formula": "",
        "key": "match_threshold",
        "label": "Keyword match threshold",
        "max": 1,
        "min": 0.5,
        "step": 0.05
      }
    ]
  },
  "step_4_invariant_catalog": {
    "allowed_subjects": [
      "spend_usd",
      "channel",
      "keyword"
    ],
    "rules": [
      {
        "description": "Never commit more than $5,000 in a week.",
        "id": "spend_cap",
        "operator": "GREATER_THAN",
        "penalty": "HARD_FAIL",
        "subject": "spend_usd",
        "threshold": 5000
      },
      {
        "description": "",
        "id": "no_tv",
        "operator": "EQUALS",
        "penalty": "HARD_FAIL",
        "subject": "channel",
        "threshold": "tv"
      },
      {
        "description": "",
        "id": "brand_safety",
        "operator": "CONTAINS_ANY",
        "penalty": "HARD_FAIL",
        "subject": "keyword",
        "threshold": [
          "counterfeit",
          "replica"
        ]
      }
    ]
  },
  "step_5_default_rubric": {
    "milestones": [
      {
        "id": "intent_f1",
        "judge": null,
        "label": "Keyword intent",
        "verifier_body": "plan = env_state['outputs'].get('intent.csv') or []\npredicted = [r['keyword'] for r in plan if r.get('intent') == 'BUY']\nexpected = tagged(ground_truth['keyword_intent.csv'], 'BUY', key='keyword')\nassert f1_set_match(predicted, expected) >= 0.99",
        "verifier_template": "f1_set_match",
        "weight": 60
      },
      {
        "id": "budget",
        "judge": null,
        "label": "Budget allocation",
        "verifier_body": "weeks = [c for c in env_state['calls'] if c['tool'] == 'set_week_budget']\nassert len(weeks) == 4",
        "verifier_template": "lp_solver_ceiling",
        "weight": 40
      }
    ]
  },
  "studio_id": "mktg-golden-fixture",
  "template_meta": {
    "domain_category": "Digital Marketing",
    "label": "Golden fixture",
    "modes": [
      "HERMETIC_MCP"
    ],
    "registry_source": "domain_templates.json",
    "template_id": "mktg-golden",
    "tpt_label": "30m (4 Wks)",
    "tpt_minutes": 30,
    "version": 1
  }
}
